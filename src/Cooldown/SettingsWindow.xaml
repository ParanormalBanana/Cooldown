<Window x:Class="Cooldown.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Cooldown"
        Title="Settings"
        Width="300"
        MaxHeight="520"
        SizeToContent="Height"
        Background="#C0C0C0"
        FontFamily="Tahoma"
        FontSize="11"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/hourglass.ico"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <local:BoolVis x:Key="BoolVis"/>
        <local:BoolVis x:Key="InvVis" Invert="True"/>
    </Window.Resources>
    <Border Background="#C0C0C0">
        <Border BorderBrush="#000000" BorderThickness="0,0,1,1">
            <Border BorderBrush="#FFFFFF" BorderThickness="1,1,0,0">
                <Border BorderBrush="#808080" BorderThickness="0,0,1,1">
                    <Border BorderBrush="#DFDFDF" BorderThickness="1,1,0,0">
                        <DockPanel>
                            <Grid x:Name="ModalCaption" DockPanel.Dock="Top" Height="22"
                                  Background="{StaticResource ActiveCaptionFill}"
                                  MouseLeftButtonDown="Caption_MouseLeftButtonDown">
                                <TextBlock Text="Settings" Foreground="White" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="6,0,28,0"
                                           IsHitTestVisible="False"/>
                                <Button Style="{StaticResource CloseButton}" Margin="0,2,3,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding CloseModalCommand}">
                                    <Image Source="{StaticResource CaptionCloseGlyph}" Width="12" Height="10" Stretch="Fill"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                </Button>
                            </Grid>

                            <StackPanel Margin="12,10,12,12">
                                <DockPanel LastChildFill="True" Margin="0,0,0,14">
                                    <ComboBox DockPanel.Dock="Right"
                                              Width="86"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource ClassicComboBox}"
                                              ItemsSource="{Binding ThemeChoices}"
                                              SelectedValue="{Binding SelectedTheme, Mode=TwoWay}"
                                              SelectedValuePath="Id"
                                              DisplayMemberPath="Label"/>
                                    <TextBlock Text="Theme" FontWeight="Bold" VerticalAlignment="Center"/>
                                </DockPanel>

                                <TextBlock Text="Watched folders" FontWeight="Bold" Margin="0,0,0,8"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="220"
                                              HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding WatchFolders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,3" LastChildFill="True" ToolTip="{Binding Key}">
                                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource TickOnly}"
                                                          IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                          VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource TinyClose}"
                                                        VerticalAlignment="Center" Margin="8,0,0,0"
                                                        Visibility="{Binding IsCustom, Converter={StaticResource BoolVis}}"
                                                        Command="{Binding DataContext.RemoveWatchFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Remove this folder">
                                                    <Path Stroke="#000000" StrokeThickness="1.4" Width="7" Height="7" Stretch="Uniform"
                                                          Data="M0,0 L8,8 M8,0 L0,8"/>
                                                </Button>
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </ScrollViewer>

                                <TextBlock Text="Blacklist" FontWeight="Bold" Margin="0,14,0,8"/>
                                <TextBlock Text="Nothing here yet." Foreground="#808080"
                                           Visibility="{Binding HasBlacklist, Converter={StaticResource InvVis}}"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="180"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Visibility="{Binding HasBlacklist, Converter={StaticResource BoolVis}}">
                                    <ItemsControl ItemsSource="{Binding Blacklist}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,3" LastChildFill="True">
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource TinyClose}"
                                                            VerticalAlignment="Center" Margin="8,0,0,0"
                                                            Command="{Binding DataContext.RemoveBlacklistCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <Path Stroke="#000000" StrokeThickness="1.4" Width="7" Height="7" Stretch="Uniform"
                                                              Data="M0,0 L8,8 M8,0 L0,8"/>
                                                    </Button>
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <DockPanel Margin="0,16,0,0">
                                    <Button DockPanel.Dock="Right" Content="Close" MinWidth="75" Height="23"
                                            Style="{StaticResource AccentButton}"
                                            Command="{Binding CloseModalCommand}"/>
                                    <TextBlock/>
                                </DockPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Border>
            </Border>
        </Border>
    </Border>
</Window>
