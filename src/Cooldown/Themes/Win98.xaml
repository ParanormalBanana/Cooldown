<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">

    <SolidColorBrush x:Key="Face" Color="#C0C0C0"/>
    <SolidColorBrush x:Key="Highlight" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Shadow" Color="#808080"/>
    <SolidColorBrush x:Key="DkShadow" Color="#000000"/>
    <SolidColorBrush x:Key="WindowBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="WindowText" Color="#000000"/>
    <SolidColorBrush x:Key="Caption" Color="#000080"/>
    <SolidColorBrush x:Key="CaptionText" Color="#FFFFFF"/>
    <LinearGradientBrush x:Key="ActiveCaptionFill" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#000080" Offset="0"/>
        <GradientStop Color="#1084D0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="InactiveCaptionFill" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#808080" Offset="0"/>
        <GradientStop Color="#B5B5B5" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Desktop" Color="#008080"/>
    <SolidColorBrush x:Key="HotTrack" Color="#000080"/>
    <SolidColorBrush x:Key="Tooltip" Color="#FFFFE1"/>
    <FontFamily x:Key="UiFont">Tahoma, Microsoft Sans Serif, Segoe UI</FontFamily>

    <!-- 8x8 Win98 caption glyphs, 1px black -->
    <DrawingImage x:Key="CaptionCloseGlyph">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 h12 v10 h-12 z"/>
                <GeometryDrawing Brush="#000000"
                                 Geometry="M0,0 h2 v1 h-2 z M10,0 h2 v1 h-2 z M1,1 h2 v1 h-2 z M9,1 h2 v1 h-2 z M2,2 h2 v1 h-2 z M8,2 h2 v1 h-2 z M3,3 h2 v1 h-2 z M7,3 h2 v1 h-2 z M4,4 h4 v1 h-4 z M4,5 h4 v1 h-4 z M3,6 h2 v1 h-2 z M7,6 h2 v1 h-2 z M2,7 h2 v1 h-2 z M8,7 h2 v1 h-2 z M1,8 h2 v1 h-2 z M9,8 h2 v1 h-2 z M0,9 h2 v1 h-2 z M10,9 h2 v1 h-2 z"/>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingBrush x:Key="Dither" TileMode="Tile" Viewport="0,0,2,2" ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#C0C0C0" Geometry="M0,0 H2 V2 H0 Z"/>
                <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 H1 V1 H0 Z M1,1 H2 V2 H1 Z"/>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    </Style>

    <Style x:Key="ClassicButton" TargetType="Button">
        <Setter Property="Background" Value="#C0C0C0"/>
        <Setter Property="Foreground" Value="#000000"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Black" BorderBrush="#000000" BorderThickness="0,0,1,1" Background="#C0C0C0">
                        <Border x:Name="White" BorderBrush="#FFFFFF" BorderThickness="1,1,0,0">
                            <Border x:Name="Dark" BorderBrush="#808080" BorderThickness="0,0,1,1">
                                <Border x:Name="Light" BorderBrush="#DFDFDF" BorderThickness="1,1,0,0">
                                    <Border x:Name="PressShift">
                                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          RecognizesAccessKey="True"
                                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                                    </Border>
                                </Border>
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Black" Property="BorderBrush" Value="#FFFFFF"/>
                            <Setter TargetName="White" Property="BorderBrush" Value="#000000"/>
                            <Setter TargetName="Dark" Property="BorderBrush" Value="#DFDFDF"/>
                            <Setter TargetName="Light" Property="BorderBrush" Value="#808080"/>
                            <Setter TargetName="PressShift" Property="Margin" Value="1,1,-1,-1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#808080"/>
                            <Setter TargetName="Black" Property="BorderBrush" Value="#8A8A8A"/>
                            <Setter TargetName="White" Property="BorderBrush" Value="#E4E4E4"/>
                            <Setter TargetName="Dark" Property="BorderBrush" Value="#A8A8A8"/>
                            <Setter TargetName="Light" Property="BorderBrush" Value="#D4D4D4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ClassicButton}"/>

    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ClassicButton}">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="DefaultRing" BorderBrush="#000000" BorderThickness="1" Background="#C0C0C0">
                        <Border x:Name="Black" BorderBrush="#000000" BorderThickness="0,0,1,1">
                            <Border x:Name="White" BorderBrush="#FFFFFF" BorderThickness="1,1,0,0">
                                <Border x:Name="Dark" BorderBrush="#808080" BorderThickness="0,0,1,1">
                                    <Border x:Name="Light" BorderBrush="#DFDFDF" BorderThickness="1,1,0,0">
                                        <Border x:Name="PressShift">
                                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              RecognizesAccessKey="True"
                                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                                        </Border>
                                    </Border>
                                </Border>
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Black" Property="BorderBrush" Value="#FFFFFF"/>
                            <Setter TargetName="White" Property="BorderBrush" Value="#000000"/>
                            <Setter TargetName="Dark" Property="BorderBrush" Value="#DFDFDF"/>
                            <Setter TargetName="Light" Property="BorderBrush" Value="#808080"/>
                            <Setter TargetName="PressShift" Property="Margin" Value="1,1,-1,-1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#808080"/>
                            <Setter TargetName="DefaultRing" Property="BorderBrush" Value="#8A8A8A"/>
                            <Setter TargetName="Black" Property="BorderBrush" Value="#8A8A8A"/>
                            <Setter TargetName="White" Property="BorderBrush" Value="#E4E4E4"/>
                            <Setter TargetName="Dark" Property="BorderBrush" Value="#A8A8A8"/>
                            <Setter TargetName="Light" Property="BorderBrush" Value="#D4D4D4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ClassicButton}"/>

    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Background" Value="#C0C0C0"/>
        <Setter Property="Foreground" Value="#000000"/>
        <Setter Property="Width" Value="21"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Black" BorderBrush="#000000" BorderThickness="0,0,1,1" Background="#C0C0C0"
                            SnapsToDevicePixels="True">
                        <Border x:Name="White" BorderBrush="#FFFFFF" BorderThickness="1,1,0,0">
                            <Border x:Name="Dark" BorderBrush="#808080" BorderThickness="0,0,1,1">
                                <Border x:Name="Light" BorderBrush="#DFDFDF" BorderThickness="1,1,0,0">
                                    <Border x:Name="PressShift">
                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                          RenderOptions.EdgeMode="Aliased"/>
                                    </Border>
                                </Border>
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Black" Property="BorderBrush" Value="#FFFFFF"/>
                            <Setter TargetName="White" Property="BorderBrush" Value="#000000"/>
                            <Setter TargetName="Dark" Property="BorderBrush" Value="#DFDFDF"/>
                            <Setter TargetName="Light" Property="BorderBrush" Value="#808080"/>
                            <Setter TargetName="PressShift" Property="Margin" Value="1,1,-1,-1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}"/>

    <Style x:Key="TinyClose" TargetType="Button">
        <Setter Property="Width" Value="15"/>
        <Setter Property="Height" Value="15"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ToolTip" Value="Remove"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Black" BorderBrush="#000000" BorderThickness="0,0,1,1" Background="#C0C0C0">
                        <Border x:Name="White" BorderBrush="#FFFFFF" BorderThickness="1,1,0,0">
                            <Border BorderBrush="#808080" BorderThickness="0,0,1,1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Black" Property="BorderBrush" Value="#FFFFFF"/>
                            <Setter TargetName="White" Property="BorderBrush" Value="#808080"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="#000000"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border Width="13" Height="13" VerticalAlignment="Center"
                                BorderBrush="#808080" BorderThickness="1,1,0,0" Background="#FFFFFF">
                            <Border BorderBrush="#000000" BorderThickness="1,1,0,0">
                                <Border BorderBrush="#DFDFDF" BorderThickness="0,0,1,1">
                                    <Path x:Name="Mark" Data="M1,5 L4,8 L10,1" Stretch="Uniform"
                                          Margin="1" Stroke="#000000" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Visibility="Hidden"/>
                                </Border>
                            </Border>
                        </Border>
                        <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#808080"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TickOnly" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border Width="13" Height="13" VerticalAlignment="Center"
                            BorderBrush="#808080" BorderThickness="1,1,0,0" Background="#FFFFFF">
                        <Border BorderBrush="#000000" BorderThickness="1,1,0,0">
                            <Border BorderBrush="#DFDFDF" BorderThickness="0,0,1,1">
                                <Path x:Name="Mark" Data="M1,5 L4,8 L10,1" Stretch="Uniform"
                                      Margin="1" Stroke="#000000" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Hidden"/>
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Width" Value="21"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#000000"/>
        <Setter Property="CaretBrush" Value="#000000"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="4,3"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Outer" BorderBrush="#808080" BorderThickness="1,1,0,0" Background="#FFFFFF">
                        <Border x:Name="Black" BorderBrush="#000000" BorderThickness="1,1,0,0">
                            <Border x:Name="Light" BorderBrush="#DFDFDF" BorderThickness="0,0,1,1">
                                <Border x:Name="White" BorderBrush="#FFFFFF" BorderThickness="0,0,1,1">
                                    <ScrollViewer x:Name="PART_ContentHost" Margin="2,1"/>
                                </Border>
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#808080"/>
                            <Setter TargetName="Outer" Property="Background" Value="#C0C0C0"/>
                            <Setter TargetName="Outer" Property="BorderBrush" Value="#A0A0A0"/>
                            <Setter TargetName="Black" Property="BorderBrush" Value="#909090"/>
                            <Setter TargetName="Light" Property="BorderBrush" Value="#D0D0D0"/>
                            <Setter TargetName="White" Property="BorderBrush" Value="#D8D8D8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="#C0C0C0"/>
        <Setter Property="Foreground" Value="#000000"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border BorderBrush="#000000" BorderThickness="0,0,1,1" Background="#C0C0C0">
                        <Border BorderBrush="#FFFFFF" BorderThickness="1,1,0,0">
                            <Border BorderBrush="#808080" BorderThickness="0,0,1,1">
                                <Border BorderBrush="#DFDFDF" BorderThickness="1,1,0,0">
                                    <StackPanel IsItemsHost="True" Margin="1"/>
                                </Border>
                            </Border>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="#000000"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="8,3,4,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter ContentSource="Header"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                            <Path x:Name="Check" Grid.Column="1" Width="8" Height="8" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M0,4 L3,7 L8,0" Visibility="Hidden"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#000080"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Margin" Value="2,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="2" BorderBrush="#808080" BorderThickness="0,1,0,0" Background="#FFFFFF"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ClassicThumb" TargetType="Thumb">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Black" BorderBrush="#000000" BorderThickness="0,0,1,1" Background="#C0C0C0">
                        <Border x:Name="White" BorderBrush="#FFFFFF" BorderThickness="1,1,0,0">
                            <Border x:Name="Dark" BorderBrush="#808080" BorderThickness="0,0,1,1">
                                <Border x:Name="Light" BorderBrush="#DFDFDF" BorderThickness="1,1,0,0" Background="#C0C0C0"/>
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Black" Property="BorderBrush" Value="#8A8A8A"/>
                            <Setter TargetName="White" Property="BorderBrush" Value="#E4E4E4"/>
                            <Setter TargetName="Dark" Property="BorderBrush" Value="#A8A8A8"/>
                            <Setter TargetName="Light" Property="BorderBrush" Value="#D4D4D4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ArrowRepeat" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Foreground" Value="#000000"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border x:Name="Black" BorderBrush="#000000" BorderThickness="0,0,1,1" Background="#C0C0C0">
                        <Border x:Name="White" BorderBrush="#FFFFFF" BorderThickness="1,1,0,0">
                            <Border x:Name="Dark" BorderBrush="#808080" BorderThickness="0,0,1,1">
                                <Border x:Name="Light" BorderBrush="#DFDFDF" BorderThickness="1,1,0,0">
                                    <Border x:Name="PressShift">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Border>
                            </Border>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Black" Property="BorderBrush" Value="#FFFFFF"/>
                            <Setter TargetName="White" Property="BorderBrush" Value="#000000"/>
                            <Setter TargetName="Dark" Property="BorderBrush" Value="#DFDFDF"/>
                            <Setter TargetName="Light" Property="BorderBrush" Value="#808080"/>
                            <Setter TargetName="PressShift" Property="Margin" Value="1,1,-1,-1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#808080"/>
                            <Setter TargetName="Black" Property="BorderBrush" Value="#8A8A8A"/>
                            <Setter TargetName="White" Property="BorderBrush" Value="#E4E4E4"/>
                            <Setter TargetName="Dark" Property="BorderBrush" Value="#A8A8A8"/>
                            <Setter TargetName="Light" Property="BorderBrush" Value="#D4D4D4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TrackRepeat" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{StaticResource Dither}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="VerticalClassicBar" TargetType="ScrollBar">
        <Grid Background="{StaticResource Dither}" Width="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="16"/>
            </Grid.RowDefinitions>
            <RepeatButton Grid.Row="0" Command="ScrollBar.LineUpCommand" Style="{StaticResource ArrowRepeat}">
                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}"
                      Data="M4,10 L8,4 L12,10 Z" Stretch="Uniform" Width="7" Height="7"/>
            </RepeatButton>
            <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource TrackRepeat}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ClassicThumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource TrackRepeat}"/>
                </Track.IncreaseRepeatButton>
            </Track>
            <RepeatButton Grid.Row="2" Command="ScrollBar.LineDownCommand" Style="{StaticResource ArrowRepeat}">
                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}"
                      Data="M4,5 L8,11 L12,5 Z" Stretch="Uniform" Width="7" Height="7"/>
            </RepeatButton>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="HorizontalClassicBar" TargetType="ScrollBar">
        <Grid Background="{StaticResource Dither}" Height="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
            </Grid.ColumnDefinitions>
            <RepeatButton Grid.Column="0" Command="ScrollBar.LineLeftCommand" Style="{StaticResource ArrowRepeat}">
                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}"
                      Data="M10,4 L4,8 L10,12 Z" Stretch="Uniform" Width="7" Height="7"/>
            </RepeatButton>
            <Track x:Name="PART_Track" Grid.Column="1">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource TrackRepeat}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ClassicThumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource TrackRepeat}"/>
                </Track.IncreaseRepeatButton>
            </Track>
            <RepeatButton Grid.Column="2" Command="ScrollBar.LineRightCommand" Style="{StaticResource ArrowRepeat}">
                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}"
                      Data="M6,4 L12,8 L6,12 Z" Stretch="Uniform" Width="7" Height="7"/>
            </RepeatButton>
        </Grid>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="16"/>
                <Setter Property="MinWidth" Value="16"/>
                <Setter Property="Template" Value="{StaticResource VerticalClassicBar}"/>
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="16"/>
                <Setter Property="MinHeight" Value="16"/>
                <Setter Property="Template" Value="{StaticResource HorizontalClassicBar}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ClassicComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="ClickMode" Value="Press"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border BorderBrush="#808080" BorderThickness="1,1,0,0" Background="#FFFFFF">
                        <Border BorderBrush="#000000" BorderThickness="1,1,0,0">
                            <Border BorderBrush="#DFDFDF" BorderThickness="0,0,1,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="17"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="1" Margin="0,1,1,1"
                                            BorderBrush="#000000" BorderThickness="0,0,1,1" Background="#C0C0C0">
                                        <Border BorderBrush="#FFFFFF" BorderThickness="1,1,0,0">
                                            <Border BorderBrush="#808080" BorderThickness="0,0,1,1">
                                                <Path HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Fill="#000000" Data="M0,0 L7,0 L3.5,4 Z"/>
                                            </Border>
                                        </Border>
                                    </Border>
                                </Grid>
                            </Border>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="#000000"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#000080"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ClassicComboBox" TargetType="ComboBox">
        <Setter Property="Height" Value="21"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#000000"/>
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource ClassicComboToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter Margin="4,2,22,2" VerticalAlignment="Center" HorizontalAlignment="Left"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>
                        <Popup x:Name="PART_Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="None">
                            <Border BorderBrush="#000000" BorderThickness="0,0,1,1" Background="#C0C0C0">
                                <Border BorderBrush="#FFFFFF" BorderThickness="1,1,0,0">
                                    <Border BorderBrush="#808080" BorderThickness="0,0,1,1">
                                        <Border BorderBrush="#DFDFDF" BorderThickness="1,1,0,0">
                                            <ScrollViewer Margin="1" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                                <StackPanel IsItemsHost="True"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Border>
                                </Border>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="18"/>
        <Setter Property="Foreground" Value="#000080"/>
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border BorderBrush="#808080" BorderThickness="1,1,0,0" Background="#FFFFFF">
                        <Border BorderBrush="#000000" BorderThickness="1,1,0,0">
                            <Border BorderBrush="#FFFFFF" BorderThickness="0,0,1,1">
                                <Grid>
                                    <Rectangle x:Name="PART_Track" Fill="#FFFFFF"/>
                                    <Decorator x:Name="PART_Indicator" HorizontalAlignment="Left">
                                        <Rectangle Fill="#000080"/>
                                    </Decorator>
                                </Grid>
                            </Border>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
