<UserControl x:Class="Cooldown.GameListRowXp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Cooldown"
             Cursor="Hand"
             FontFamily="Tahoma"
             UseLayoutRounding="True"
             HorizontalAlignment="Stretch">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/WinXp.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:BoolVis x:Key="BoolVis"/>
            <local:BoolVis x:Key="InvVis" Invert="True"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                    <Setter Property="Opacity" Value="0.72"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <UserControl.ContextMenu>
        <ContextMenu Opened="CardMenu_Opened"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <ContextMenu.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="Themes/WinXp.xaml"/>
                    </ResourceDictionary.MergedDictionaries>
                    <local:BoolVis x:Key="BoolVis"/>
                    <local:BoolVis x:Key="InvVis" Invert="True"/>
                </ResourceDictionary>
            </ContextMenu.Resources>
            <MenuItem Header="Hide game" Click="Hide_Click"
                      Visibility="{Binding IsHidden, Converter={StaticResource InvVis}}"/>
            <MenuItem Header="Unhide game" Click="Unhide_Click"
                      Visibility="{Binding IsHidden, Converter={StaticResource BoolVis}}"/>
            <MenuItem Header="Not a game" Click="NotAGame_Click"/>
            <Separator/>
            <MenuItem x:Name="ToggleHiddenItem" Header="Show hidden games" IsCheckable="True"
                      Click="ToggleHidden_Click"/>
            <MenuItem x:Name="ToggleCooldownsOnTopItem" Header="Cooldown games on top" IsCheckable="True"
                      Click="ToggleCooldownsOnTop_Click"/>
            <Separator/>
            <MenuItem x:Name="GridViewItem" Header="Grid" IsCheckable="True"
                      Click="ShowGrid_Click"/>
            <MenuItem x:Name="ListViewItem" Header="List" IsCheckable="True"
                      Click="ShowDetails_Click"/>
            <Separator/>
            <MenuItem Header="Settings..." Click="Settings_Click"/>
        </ContextMenu>
    </UserControl.ContextMenu>
    <Border x:Name="Root" Background="#FFFFFF" BorderBrush="#E2DED5" BorderThickness="0,0,0,1"
            SnapsToDevicePixels="True" UseLayoutRounding="True"
            HorizontalAlignment="Stretch"
            MouseLeftButtonDown="Row_MouseLeftButtonDown"
            MouseLeftButtonUp="Row_MouseLeftButtonUp"
            LostMouseCapture="Row_LostMouseCapture"
            MouseEnter="Row_MouseEnter"
            MouseLeave="Row_MouseLeave">
        <Grid Height="22" Margin="4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="148"/>
                <ColumnDefinition Width="88"/>
                <ColumnDefinition Width="148"/>
            </Grid.ColumnDefinitions>
            <Border Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="3" BorderBrush="#003C74" BorderThickness="1"
                    Background="{DynamicResource XpButtonFill}"
                    Visibility="{Binding OnCooldown, Converter={StaticResource BoolVis}}">
                <Grid Margin="2" SnapsToDevicePixels="True">
                    <Image Source="pack://application:,,,/Assets/hourglass-16-white.png"
                           Stretch="Uniform" Margin="1,1,0,0" Opacity="0.35"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <Rectangle Fill="#003C74" Margin="0,0,1,1"
                               SnapsToDevicePixels="True">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="pack://application:,,,/Assets/hourglass-16.png"
                                        Stretch="Uniform"/>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </Grid>
            </Border>
            <Grid Grid.Column="1" Margin="2,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" Background="#3A6EA5">
                    <Image Source="{Binding Cover}" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="Fant"/>
                </Border>
                <TextBlock x:Name="TitleText" Grid.Column="1" Text="{Binding Title}" FontSize="11" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
            <TextBlock x:Name="LauncherText" Grid.Column="2" Text="{Binding Launcher}" FontSize="11"
                       HorizontalAlignment="Stretch" TextAlignment="Right"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0"/>
            <TextBlock x:Name="DaysLabel" Grid.Column="3" Text="{Binding DaysText}" FontSize="11"
                       HorizontalAlignment="Stretch" TextAlignment="Right"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0"/>
            <TextBlock x:Name="ReinstallsLabel" Grid.Column="4" Text="{Binding ReinstallsText}" FontSize="11"
                       HorizontalAlignment="Stretch" TextAlignment="Right"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0"/>
            <TextBlock x:Name="ScoreLabel" Grid.Column="5" Text="{Binding ScoreText}" FontSize="11"
                       HorizontalAlignment="Stretch" TextAlignment="Right"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0"/>
        </Grid>
    </Border>
</UserControl>
