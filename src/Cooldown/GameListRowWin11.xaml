<UserControl x:Class="Cooldown.GameListRowWin11"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Cooldown"
             Cursor="Hand"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             UseLayoutRounding="True"
             HorizontalAlignment="Stretch">
    <UserControl.Resources>
        <local:BoolVis x:Key="BoolVis"/>
        <local:BoolVis x:Key="InvVis" Invert="True"/>
    </UserControl.Resources>
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                    <Setter Property="Opacity" Value="0.72"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <UserControl.ContextMenu>
        <ContextMenu Opened="CardMenu_Opened"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <ContextMenu.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="Themes/Win11Light.xaml"/>
                        <ResourceDictionary Source="Themes/Win11.xaml"/>
                    </ResourceDictionary.MergedDictionaries>
                    <local:BoolVis x:Key="BoolVis"/>
                    <local:BoolVis x:Key="InvVis" Invert="True"/>
                </ResourceDictionary>
            </ContextMenu.Resources>
            <MenuItem Header="Hide game" Click="Hide_Click"
                      Visibility="{Binding IsHidden, Converter={StaticResource InvVis}}"/>
            <MenuItem Header="Unhide game" Click="Unhide_Click"
                      Visibility="{Binding IsHidden, Converter={StaticResource BoolVis}}"/>
            <MenuItem Header="Not a game" Click="NotAGame_Click"/>
            <Separator/>
            <MenuItem x:Name="ToggleHiddenItem" Header="Show hidden games" IsCheckable="True"
                      Click="ToggleHidden_Click"/>
            <MenuItem x:Name="ToggleCooldownsOnTopItem" Header="Cooldown games on top" IsCheckable="True"
                      Click="ToggleCooldownsOnTop_Click"/>
            <Separator/>
            <MenuItem x:Name="GridViewItem" Header="Grid" IsCheckable="True"
                      Click="ShowGrid_Click"/>
            <MenuItem x:Name="ListViewItem" Header="List" IsCheckable="True"
                      Click="ShowDetails_Click"/>
            <Separator/>
            <MenuItem Header="Settings..." Click="Settings_Click"/>
        </ContextMenu>
    </UserControl.ContextMenu>
    <Border x:Name="Root" Background="Transparent" CornerRadius="4"
            SnapsToDevicePixels="True" UseLayoutRounding="True"
            HorizontalAlignment="Stretch"
            MouseLeftButtonDown="Row_MouseLeftButtonDown"
            MouseLeftButtonUp="Row_MouseLeftButtonUp"
            LostMouseCapture="Row_LostMouseCapture"
            MouseEnter="Row_MouseEnter"
            MouseLeave="Row_MouseLeave">
        <Grid Height="36" Margin="4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="156"/>
                <ColumnDefinition Width="96"/>
                <ColumnDefinition Width="160"/>
            </Grid.ColumnDefinitions>
            <Border Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="4" Background="{DynamicResource BadgeFill}"
                    Visibility="{Binding OnCooldown, Converter={StaticResource BoolVis}}">
                <Grid Margin="4" SnapsToDevicePixels="True">
                    <Rectangle Fill="{DynamicResource WindowText}"
                               SnapsToDevicePixels="True">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="pack://application:,,,/Assets/hourglass-16.png"
                                        Stretch="Uniform"/>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </Grid>
            </Border>
            <Grid Grid.Column="1" Margin="2,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center"
                        Background="{DynamicResource CoverFallback}">
                    <Border.Clip>
                        <RectangleGeometry Rect="0,0,24,24" RadiusX="8" RadiusY="8"/>
                    </Border.Clip>
                    <Image Source="{Binding Cover}" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="Fant"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource WindowText}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OnCooldown}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource GrayText}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <TextBlock Grid.Column="2" Text="{Binding Launcher}" FontSize="12"
                       HorizontalAlignment="Stretch" TextAlignment="Right"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0"
                       Foreground="{DynamicResource GrayText}"/>
            <TextBlock Grid.Column="3" Text="{Binding DaysText}" FontSize="12"
                       HorizontalAlignment="Stretch" TextAlignment="Right"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0"
                       Foreground="{DynamicResource WindowText}"/>
            <TextBlock Grid.Column="4" Text="{Binding ReinstallsText}" FontSize="12"
                       HorizontalAlignment="Stretch" TextAlignment="Right"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0"
                       Foreground="{DynamicResource WindowText}"/>
            <TextBlock Grid.Column="5" Text="{Binding ScoreText}" FontSize="12"
                       HorizontalAlignment="Stretch" TextAlignment="Right"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0"
                       Foreground="{DynamicResource WindowText}"/>
        </Grid>
    </Border>
</UserControl>
