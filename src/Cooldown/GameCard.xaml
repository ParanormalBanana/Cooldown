<UserControl x:Class="Cooldown.GameCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Cooldown"
             Cursor="Hand"
             FontFamily="Tahoma"
             UseLayoutRounding="True"
             HorizontalAlignment="Stretch">
    <UserControl.Resources>
        <local:BoolVis x:Key="BoolVis"/>
        <local:BoolVis x:Key="InvVis" Invert="True"/>
        <local:GrayCover x:Key="GrayCover"/>
        <local:AnyTrueVis x:Key="AnyTrueVis"/>
        <local:AnyTrueVis x:Key="NoneTrueVis" Invert="True"/>
    </UserControl.Resources>
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                    <Setter Property="Opacity" Value="0.72"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <UserControl.ContextMenu>
        <ContextMenu Opened="CardMenu_Opened"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <ContextMenu.Resources>
                <local:BoolVis x:Key="BoolVis"/>
                <local:BoolVis x:Key="InvVis" Invert="True"/>
            </ContextMenu.Resources>
            <MenuItem Header="Hide game" Click="Hide_Click"
                      Visibility="{Binding IsHidden, Converter={StaticResource InvVis}}"/>
            <MenuItem Header="Unhide game" Click="Unhide_Click"
                      Visibility="{Binding IsHidden, Converter={StaticResource BoolVis}}"/>
            <MenuItem Header="Not a game" Click="NotAGame_Click"/>
            <Separator/>
            <MenuItem x:Name="ToggleHiddenItem" Header="Show hidden games" IsCheckable="True"
                      Click="ToggleHidden_Click"/>
        </ContextMenu>
    </UserControl.ContextMenu>
    <Border x:Name="Root" SnapsToDevicePixels="True" UseLayoutRounding="True"
            HorizontalAlignment="Stretch"
            Background="#C0C0C0"
            BorderBrush="#000000"
            BorderThickness="0,0,1,1"
            MouseLeftButtonDown="Card_MouseLeftButtonDown"
            MouseLeftButtonUp="Card_MouseLeftButtonUp"
            LostMouseCapture="Card_LostMouseCapture">
        <Border x:Name="BevelWhite" BorderBrush="#FFFFFF" BorderThickness="1,1,0,0">
            <Border x:Name="BevelDark" BorderBrush="#808080" BorderThickness="0,0,1,1">
                <Border x:Name="BevelLight" BorderBrush="#DFDFDF" BorderThickness="1,1,0,0">
                    <Border x:Name="PressShift">
                <StackPanel>
                    <Grid Height="{Binding DataContext.CoverHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                          ClipToBounds="True" Margin="4,4,4,0">
                        <Border BorderBrush="#808080" BorderThickness="1,1,0,0">
                            <Border BorderBrush="#000000" BorderThickness="1,1,0,0">
                                <Border BorderBrush="#FFFFFF" BorderThickness="0,0,1,1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#008080"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding OnCooldown}" Value="True">
                                                    <Setter Property="Background" Value="#808080"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DataContext.ModalOpen, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                    <Setter Property="Background" Value="#808080"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Image Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                               Source="{Binding Cover}">
                                            <Image.Visibility>
                                                <MultiBinding Converter="{StaticResource NoneTrueVis}">
                                                    <Binding Path="OnCooldown"/>
                                                    <Binding Path="DataContext.ModalOpen" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                </MultiBinding>
                                            </Image.Visibility>
                                        </Image>
                                        <Image Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                               Source="{Binding Cover, Converter={StaticResource GrayCover}}">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Opacity" Value="0.75"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding OnCooldown}" Value="True">
                                                            <Setter Property="Opacity" Value="0.55"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                            <Image.Visibility>
                                                <MultiBinding Converter="{StaticResource AnyTrueVis}">
                                                    <Binding Path="OnCooldown"/>
                                                    <Binding Path="DataContext.ModalOpen" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                </MultiBinding>
                                            </Image.Visibility>
                                        </Image>
                                        <Border Background="#66C0C0C0">
                                            <Border.Visibility>
                                                <MultiBinding Converter="{StaticResource AnyTrueVis}">
                                                    <Binding Path="OnCooldown"/>
                                                    <Binding Path="DataContext.ModalOpen" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                </MultiBinding>
                                            </Border.Visibility>
                                        </Border>
                                        <Border Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Margin="4" Background="#C0C0C0"
                                                Visibility="{Binding OnCooldown, Converter={StaticResource BoolVis}}">
                                            <Border BorderBrush="#000000" BorderThickness="0,0,1,1">
                                                <Border BorderBrush="#FFFFFF" BorderThickness="1,1,0,0">
                                                    <Border BorderBrush="#808080" BorderThickness="0,0,1,1">
                                                        <Grid Margin="2" SnapsToDevicePixels="True">
                                                            <Image Source="pack://application:,,,/Assets/hourglass-16-white.png"
                                                                   Stretch="Uniform" Margin="1,1,0,0" Opacity="0.4"
                                                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                                            <Rectangle Fill="#3A3A3A" Margin="0,0,1,1"
                                                                       SnapsToDevicePixels="True">
                                                                <Rectangle.OpacityMask>
                                                                    <ImageBrush ImageSource="pack://application:,,,/Assets/hourglass-16.png"
                                                                                Stretch="Uniform"/>
                                                                </Rectangle.OpacityMask>
                                                            </Rectangle>
                                                        </Grid>
                                                    </Border>
                                                </Border>
                                            </Border>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Border>
                        </Border>
                    </Grid>
                    <Border x:Name="TitleWell" Height="32" Margin="4,4,4,4">
                        <Grid>
                            <TextBlock Text="{Binding Title}" FontSize="11"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       TextAlignment="Center" Margin="4,0">
                                <TextBlock.Visibility>
                                    <MultiBinding Converter="{StaticResource NoneTrueVis}">
                                        <Binding Path="OnCooldown"/>
                                        <Binding Path="DataContext.ModalOpen" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    </MultiBinding>
                                </TextBlock.Visibility>
                            </TextBlock>
                            <Grid>
                                <Grid.Visibility>
                                    <MultiBinding Converter="{StaticResource AnyTrueVis}">
                                        <Binding Path="OnCooldown"/>
                                        <Binding Path="DataContext.ModalOpen" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                    </MultiBinding>
                                </Grid.Visibility>
                                <TextBlock Text="{Binding Title}" FontSize="11" Foreground="#FFFFFF"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           TextAlignment="Center" Margin="5,1,3,0"/>
                                <TextBlock Text="{Binding Title}" FontSize="11" Foreground="#808080"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           TextAlignment="Center" Margin="4,0,4,1"/>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
                    </Border>
                </Border>
            </Border>
        </Border>
    </Border>
</UserControl>
