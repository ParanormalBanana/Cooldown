<UserControl x:Class="Cooldown.GameCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Cooldown"
             Cursor="Hand">
    <UserControl.Resources>
        <local:BoolVis x:Key="BoolVis"/>
        <local:BoolVis x:Key="InvVis" Invert="True"/>
    </UserControl.Resources>
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                    <Setter Property="Opacity" Value="0.72"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <UserControl.InputBindings>
        <MouseBinding MouseAction="LeftClick"
                      Command="{Binding DataContext.SelectGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding}"/>
    </UserControl.InputBindings>
    <UserControl.ContextMenu>
        <ContextMenu Opened="CardMenu_Opened"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <ContextMenu.Resources>
                <local:BoolVis x:Key="BoolVis"/>
                <local:BoolVis x:Key="InvVis" Invert="True"/>
            </ContextMenu.Resources>
            <MenuItem Header="Hide game" Click="Hide_Click"
                      Visibility="{Binding IsHidden, Converter={StaticResource InvVis}}"/>
            <MenuItem Header="Unhide game" Click="Unhide_Click"
                      Visibility="{Binding IsHidden, Converter={StaticResource BoolVis}}"/>
            <MenuItem Header="Not a game" Click="NotAGame_Click"/>
            <Separator/>
            <MenuItem x:Name="ToggleHiddenItem" Header="Show hidden games" Click="ToggleHidden_Click"/>
        </ContextMenu>
    </UserControl.ContextMenu>
    <Border x:Name="Root" CornerRadius="8" SnapsToDevicePixels="True"
            Width="{Binding DataContext.CardWidth, RelativeSource={RelativeSource AncestorType=Window}}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="#1A1E24"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding OnCooldown}" Value="True">
                        <Setter Property="Background" Value="#1A2A32"/>
                    </DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#252B34"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel>
            <Grid Height="{Binding DataContext.CoverHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                  ClipToBounds="True">
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#161D26" Offset="0"/>
                            <GradientStop Color="#243044" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Image Source="{Binding Cover}" Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="LowQuality"/>
                <Border Background="#662A4A52"
                        Visibility="{Binding OnCooldown, Converter={StaticResource BoolVis}}"/>
                <Border Width="32" Height="32" CornerRadius="16"
                        Background="#CC123038" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="8" BorderBrush="#7ED4D4" BorderThickness="1.2"
                        Visibility="{Binding OnCooldown, Converter={StaticResource BoolVis}}">
                    <Viewbox Width="16" Height="16">
                        <Canvas Width="24" Height="24">
                            <Path Stroke="#7ED4D4" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M12,2 L12,22 M2,12 L22,12 M5.2,5.2 L18.8,18.8 M18.8,5.2 L5.2,18.8"/>
                            <Path Stroke="#7ED4D4" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M12,6 L9.5,4.2 M12,6 L14.5,4.2 M12,18 L9.5,19.8 M12,18 L14.5,19.8 M6,12 L4.2,9.5 M6,12 L4.2,14.5 M18,12 L19.8,9.5 M18,12 L19.8,14.5"/>
                        </Canvas>
                    </Viewbox>
                </Border>
            </Grid>
            <Border Background="#1C2128" Height="44">
                <TextBlock Text="{Binding Title}" FontSize="13" FontFamily="Segoe UI"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Margin="10,0,12,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#F2F4F7"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                    <Setter Property="Foreground" Value="#8B98A8"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding OnCooldown}" Value="True">
                                    <Setter Property="Foreground" Value="#7ED4D4"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
