<Window x:Class="Cooldown.SettingsWindowXp"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Cooldown"
        Title="Settings"
        Width="300"
        MaxHeight="520"
        SizeToContent="Height"
        Background="#0831D9"
        FontFamily="Tahoma"
        FontSize="11"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/hourglass.ico"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/WinXp.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:BoolVis x:Key="BoolVis"/>
            <local:BoolVis x:Key="InvVis" Invert="True"/>
        </ResourceDictionary>
    </Window.Resources>
    <Border x:Name="Root" CornerRadius="8,8,0,0" Background="#0831D9">
        <DockPanel>
            <Border x:Name="ModalCaption" DockPanel.Dock="Top" Height="30" CornerRadius="8,8,0,0"
                    Background="{StaticResource ActiveCaptionFill}"
                    MouseLeftButtonDown="Caption_MouseLeftButtonDown">
                <Border CornerRadius="8,8,0,0" BorderBrush="#00138B" BorderThickness="1,1,0,0">
                  <Border CornerRadius="7,7,0,0" BorderBrush="#001EA0" BorderThickness="0,0,1,0">
                   <Grid>
                    <Grid IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Stretch="Fill" SnapsToDevicePixels="True"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               Source="pack://application:,,,/Assets/Xp/caption-left.png"/>
                        <Image Grid.Column="1" Stretch="Fill" SnapsToDevicePixels="True"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               Source="pack://application:,,,/Assets/Xp/caption-fill.png"/>
                        <Image Grid.Column="2" Stretch="Fill" SnapsToDevicePixels="True"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               Source="pack://application:,,,/Assets/Xp/caption-right.png"/>
                    </Grid>
                    <Grid Margin="4,2,4,2">
                        <TextBlock Text="Settings" Foreground="White" FontWeight="Bold"
                                   FontFamily="{StaticResource CaptionFont}" FontSize="13"
                                   VerticalAlignment="Center" Margin="3,0,28,0"
                                   IsHitTestVisible="False">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#0F1089" ShadowDepth="1" Direction="315" BlurRadius="0" Opacity="1"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <Button Style="{StaticResource CloseButton}"
                                VerticalAlignment="Center"
                                Command="{Binding CloseModalCommand}"/>
                    </Grid>
                   </Grid>
                  </Border>
                </Border>
            </Border>

            <Border Background="#0831D9" Padding="3,0,3,3"
                    BorderBrush="#001EA0" BorderThickness="1,0,1,1">
                <Border Background="#ECE9D8">
                    <StackPanel Margin="12,10,12,12">
                                            <DockPanel LastChildFill="True" Margin="0,0,0,14">
                                                <ComboBox DockPanel.Dock="Right"
                                                          Width="86"
                                                          HorizontalAlignment="Right"
                                                          VerticalAlignment="Center"
                                                          Style="{StaticResource ClassicComboBox}"
                                                          ItemsSource="{Binding ThemeChoices}"
                                                          SelectedValue="{Binding SelectedTheme, Mode=TwoWay}"
                                                          SelectedValuePath="Id"
                                                          DisplayMemberPath="Label"/>
                                                <TextBlock Text="Theme" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </DockPanel>

                                            <TextBlock Text="Watched folders" FontWeight="Bold" Margin="0,0,0,8"/>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="220"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl ItemsSource="{Binding WatchFolders}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <DockPanel Margin="0,3" LastChildFill="True" ToolTip="{Binding Key}">
                                                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource TickOnly}"
                                                                          IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                                          VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                                <Button DockPanel.Dock="Right" Style="{StaticResource TinyClose}"
                                                                        VerticalAlignment="Center" Margin="8,0,0,0"
                                                                        Visibility="{Binding IsCustom, Converter={StaticResource BoolVis}}"
                                                                        Command="{Binding DataContext.RemoveWatchFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        ToolTip="Remove this folder">
                                                                    <Path Stroke="#000000" StrokeThickness="1.4" Width="7" Height="7" Stretch="Uniform"
                                                                          Data="M0,0 L8,8 M8,0 L0,8"/>
                                                                </Button>
                                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>

                                            <TextBlock Text="Blacklist" FontWeight="Bold" Margin="0,14,0,8"/>
                                            <TextBlock Text="Nothing here yet." Foreground="#5A574B"
                                                       Visibility="{Binding HasBlacklist, Converter={StaticResource InvVis}}"/>
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="180"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          Visibility="{Binding HasBlacklist, Converter={StaticResource BoolVis}}">
                                                <ItemsControl ItemsSource="{Binding Blacklist}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <DockPanel Margin="0,3" LastChildFill="True">
                                                                <Button DockPanel.Dock="Right" Style="{StaticResource TinyClose}"
                                                                        VerticalAlignment="Center" Margin="8,0,0,0"
                                                                        Command="{Binding DataContext.RemoveBlacklistCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}">
                                                                    <Path Stroke="#000000" StrokeThickness="1.4" Width="7" Height="7" Stretch="Uniform"
                                                                          Data="M0,0 L8,8 M8,0 L0,8"/>
                                                                </Button>
                                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>

                                            <DockPanel Margin="0,16,0,0">
                                                <Button DockPanel.Dock="Right" Content="Close" MinWidth="75" Height="23"
                                                        Style="{StaticResource AccentButton}"
                                                        Command="{Binding CloseModalCommand}"/>
                                                <TextBlock/>
                                            </DockPanel>
                                        </StackPanel>
                </Border>
            </Border>
        </DockPanel>
    </Border>
</Window>
