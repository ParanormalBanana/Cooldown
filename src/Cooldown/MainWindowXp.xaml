<Window x:Class="Cooldown.MainWindowXp"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Cooldown"
        Title="Cooldown"
        Width="1180" Height="780" MinWidth="960" MinHeight="640"
        Foreground="#000000"
        FontFamily="Tahoma"
        FontSize="11"
        WindowStyle="None"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/hourglass.ico"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown"
        SizeChanged="Window_SizeChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="30"
                            ResizeBorderThickness="4"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/WinXp.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:BoolVis x:Key="BoolVis"/>
            <local:BoolVis x:Key="InvVis" Invert="True"/>
        </ResourceDictionary>
    </Window.Resources>
    <Window.Style>
        <Style TargetType="local:MainWindowXp">
            <Setter Property="Background" Value="{StaticResource ActiveFrameFill}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ModalOpen}" Value="True">
                    <Setter Property="Background" Value="{StaticResource InactiveFrameFill}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>

    <Border x:Name="Root" CornerRadius="8,8,0,0">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{StaticResource ActiveFrameFill}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ModalOpen}" Value="True">
                        <Setter Property="Background" Value="{StaticResource InactiveFrameFill}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Luna caption: edge-to-edge so the gradient is the window top, not a bar inside a blue ring -->
            <Border x:Name="CaptionBar" Grid.Row="0" CornerRadius="8,8,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource ActiveCaptionFill}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ModalOpen}" Value="True">
                                <Setter Property="Background" Value="{StaticResource InactiveCaptionFill}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid IsHitTestVisible="False">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ModalOpen}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Stretch="Fill" SnapsToDevicePixels="True"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               Source="pack://application:,,,/Assets/Xp/caption-left.png"/>
                        <Image Grid.Column="1" Stretch="Fill" SnapsToDevicePixels="True"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               Source="pack://application:,,,/Assets/Xp/caption-fill.png"/>
                        <Image Grid.Column="2" Stretch="Fill" SnapsToDevicePixels="True"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               Source="pack://application:,,,/Assets/Xp/caption-right.png"/>
                    </Grid>
                <Border CornerRadius="8,8,0,0" BorderThickness="1,1,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{StaticResource ActiveCaptionEdge}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ModalOpen}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource InactiveCaptionEdge}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border CornerRadius="7,7,0,0" BorderThickness="0,0,1,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{StaticResource ActiveFrameEdge}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ModalOpen}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource InactiveFrameEdge}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                <Grid Margin="4,2,4,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Width="16" Height="16" Margin="1,0,4,0"
                           VerticalAlignment="Center" HorizontalAlignment="Left"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           Source="pack://application:,,,/Assets/hourglass-16-white.png">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ModalOpen}" Value="True">
                                        <Setter Property="Opacity" Value="0.72"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <TextBlock Grid.Column="1" Text="Cooldown" FontFamily="{StaticResource CaptionFont}"
                               FontWeight="Bold" FontSize="13" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#0F1089" ShadowDepth="1" Direction="315" BlurRadius="0" Opacity="1"/>
                        </TextBlock.Effect>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontFamily" Value="{StaticResource CaptionFont}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ModalOpen}" Value="True">
                                        <Setter Property="Foreground" Value="#D8E4F0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ModalOpen}" Value="True">
                                        <Setter Property="Opacity" Value="0.55"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Style="{StaticResource XpCaptionMin}" Click="Minimize_Click" ToolTip="Minimize"/>
                        <Button x:Name="MaxButton" Style="{StaticResource XpCaptionMax}" Click="Maximize_Click" ToolTip="Maximize">
                            <Grid Width="21" Height="21">
                                <Image x:Name="MaxIcon" Width="21" Height="21" Stretch="Fill"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       Source="pack://application:,,,/Assets/Xp/maximize.png"/>
                                <Image x:Name="RestoreIcon" Width="21" Height="21" Stretch="Fill" Visibility="Collapsed"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       Source="pack://application:,,,/Assets/Xp/restore.png"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource CaptionCloseButton}" Click="Close_Click" ToolTip="Close"/>
                    </StackPanel>
                </Grid>
                    </Border>
                </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1" Padding="3,0,3,3" BorderThickness="1,0,1,1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource ActiveFrameFill}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource ActiveFrameEdge}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ModalOpen}" Value="True">
                                <Setter Property="Background" Value="{StaticResource InactiveFrameFill}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource InactiveFrameEdge}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border Background="#ECE9D8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="22"/>
                    </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <ContextMenu.Resources>
                                            <ResourceDictionary>
                                                <ResourceDictionary.MergedDictionaries>
                                                    <ResourceDictionary Source="Themes/WinXp.xaml"/>
                                                </ResourceDictionary.MergedDictionaries>
                                            </ResourceDictionary>
                                        </ContextMenu.Resources>
                                        <MenuItem Header="Show hidden games" IsCheckable="True"
                                                  IsChecked="{Binding ShowHidden, Mode=OneWay}"
                                                  Command="{Binding ToggleHiddenCommand}"/>
                                        <MenuItem Header="Cooldown games on top" IsCheckable="True"
                                                  IsChecked="{Binding CooldownsOnTop, Mode=OneWay}"
                                                  Command="{Binding ToggleCooldownsOnTopCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="Grid" IsCheckable="True"
                                                  IsChecked="{Binding GridView, Mode=OneWay}"
                                                  Command="{Binding ShowGridViewCommand}"/>
                                        <MenuItem Header="List" IsCheckable="True"
                                                  IsChecked="{Binding DetailsView, Mode=OneWay}"
                                                  Command="{Binding ShowDetailsViewCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="Settings..." Command="{Binding OpenSettingsCommand}"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Margin="8,6,8,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                                             Height="23" VerticalContentAlignment="Center"
                                             IsEnabled="{Binding ParentEnabled}"/>
                                    <Button Grid.Column="1" Content="+" Width="26" Height="23" Margin="6,0,0,0" Padding="0"
                                            FontSize="12" FontWeight="Bold"
                                            Style="{StaticResource GhostButton}"
                                            Command="{Binding OpenAddCommand}"
                                            IsEnabled="{Binding ParentEnabled}"
                                            ToolTip="Scan a folder for games"/>
                                    <Button Grid.Column="2" Content="{Binding RescanLabel}" MinWidth="100" Height="23" Margin="6,0,0,0"
                                            Padding="10,2"
                                            Style="{StaticResource AccentButton}"
                                            Command="{Binding RescanCommand}"
                                            IsEnabled="{Binding RescanEnabled}"/>
                                </Grid>

                                <Grid Grid.Row="1" Margin="8,0,8,8">
                                  <Border BorderBrush="#716F64" BorderThickness="1,1,0,0">
                                    <Border BorderBrush="#FFFFFF" BorderThickness="0,0,1,1">
                                      <Border BorderBrush="#ACA899" BorderThickness="1,1,0,0">
                                        <Border BorderBrush="#ECE9D8" BorderThickness="0,0,1,1" Background="#FFFFFF">
                                          <Grid>
                                    <ListBox x:Name="GameList"
                                             ItemsSource="{Binding Rows}"
                                             Background="#FFFFFF"
                                             BorderThickness="0"
                                             Padding="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.CanContentScroll="True"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling"
                                             VirtualizingPanel.ScrollUnit="Pixel"
                                             PreviewMouseWheel="GameList_PreviewMouseWheel">
                                        <ListBox.Resources>
                                            <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
                                                <Style.Triggers>
                                                    <Trigger Property="Orientation" Value="Vertical">
                                                        <Setter Property="Width" Value="21"/>
                                                        <Setter Property="MinWidth" Value="21"/>
                                                        <Setter Property="MaxWidth" Value="21"/>
                                                        <Setter Property="Template" Value="{StaticResource VerticalClassicBar}"/>
                                                    </Trigger>
                                                    <Trigger Property="Orientation" Value="Horizontal">
                                                        <Setter Property="Height" Value="21"/>
                                                        <Setter Property="MinHeight" Value="21"/>
                                                        <Setter Property="MaxHeight" Value="21"/>
                                                        <Setter Property="Template" Value="{StaticResource HorizontalClassicBar}"/>
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding ModalOpen}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListBox.Resources>
                                        <ListBox.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <ContextMenu.Resources>
                                                    <ResourceDictionary>
                                                        <ResourceDictionary.MergedDictionaries>
                                                            <ResourceDictionary Source="Themes/WinXp.xaml"/>
                                                        </ResourceDictionary.MergedDictionaries>
                                                    </ResourceDictionary>
                                                </ContextMenu.Resources>
                                                <MenuItem Header="Show hidden games" IsCheckable="True"
                                                  IsChecked="{Binding ShowHidden, Mode=OneWay}"
                                                  Command="{Binding ToggleHiddenCommand}"/>
                                                <MenuItem Header="Cooldown games on top" IsCheckable="True"
                                                  IsChecked="{Binding CooldownsOnTop, Mode=OneWay}"
                                                  Command="{Binding ToggleCooldownsOnTopCommand}"/>
                                                <Separator/>
                                                <MenuItem Header="Grid" IsCheckable="True"
                                                  IsChecked="{Binding GridView, Mode=OneWay}"
                                                  Command="{Binding ShowGridViewCommand}"/>
                                                <MenuItem Header="List" IsCheckable="True"
                                                  IsChecked="{Binding DetailsView, Mode=OneWay}"
                                                  Command="{Binding ShowDetailsViewCommand}"/>
                                                <Separator/>
                                                <MenuItem Header="Settings..." Command="{Binding OpenSettingsCommand}"/>
                                            </ContextMenu>
                                        </ListBox.ContextMenu>
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel>
                                                    <VirtualizingStackPanel.Style>
                                                        <Style TargetType="VirtualizingStackPanel">
                                                            <Setter Property="Margin" Value="0,-4"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.DetailsView, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                    <Setter Property="Margin" Value="0,4,0,0"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </VirtualizingStackPanel.Style>
                                                </VirtualizingStackPanel>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Focusable" Value="False"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <ContentPresenter/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="4,0">
                                                    <TextBlock Text="{Binding Header}" FontSize="11" FontWeight="Bold"
                                                               Margin="8,6,8,2"
                                                               Visibility="{Binding IsHeader, Converter={StaticResource BoolVis}}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                <Setter Property="Foreground" Value="#316AC5"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DataContext.ModalOpen, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                        <Setter Property="Foreground" Value="#808080"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <ItemsControl ItemsSource="{Binding Items}"
                                                                  Visibility="{Binding HasItems, Converter={StaticResource BoolVis}}">
                                                        <ItemsControl.Style>
                                                            <Style TargetType="ItemsControl">
                                                                <Setter Property="ItemsPanel">
                                                                    <Setter.Value>
                                                                        <ItemsPanelTemplate>
                                                                            <UniformGrid Rows="1"
                                                                                         Columns="{Binding DataContext.ColumnCount, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                        </ItemsPanelTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Setter Property="ItemTemplate">
                                                                    <Setter.Value>
                                                                        <DataTemplate>
                                                                            <local:GameCardXp Margin="4,4"/>
                                                                        </DataTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DataContext.DetailsView, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                        <Setter Property="ItemsPanel">
                                                                            <Setter.Value>
                                                                                <ItemsPanelTemplate>
                                                                                    <StackPanel/>
                                                                                </ItemsPanelTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                        <Setter Property="ItemTemplate">
                                                                            <Setter.Value>
                                                                                <DataTemplate>
                                                                                    <local:GameListRowXp/>
                                                                                </DataTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ItemsControl.Style>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <TextBlock Text="{Binding EmptyMessage}"
                                               Margin="12,16"
                                               Visibility="{Binding ShowEmpty, Converter={StaticResource BoolVis}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Foreground" Value="#000000"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ModalOpen}" Value="True">
                                                        <Setter Property="Foreground" Value="#808080"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Visibility="{Binding ShowSplash, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="Finding your games..." FontSize="12" FontWeight="Bold"
                                                   HorizontalAlignment="Center" Margin="0,0,0,8">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Foreground" Value="#000000"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ModalOpen}" Value="True">
                                                            <Setter Property="Foreground" Value="#808080"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding SplashStatus}" FontSize="11"
                                                   HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Foreground" Value="#000000"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ModalOpen}" Value="True">
                                                            <Setter Property="Foreground" Value="#808080"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ProgressBar IsIndeterminate="True" Width="280" Height="18" Margin="0,14,0,0"/>
                                    </StackPanel>
                                          </Grid>
                                        </Border>
                                      </Border>
                                    </Border>
                                  </Border>
                                </Grid>
                            </Grid>

                            <!-- Luna status bar -->
                            <Border Grid.Row="1" Background="#ECE9D8">
                                <Border BorderBrush="#ACA899" BorderThickness="0,1,0,0">
                                    <Grid Height="20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="16"/>
                                        </Grid.ColumnDefinitions>
                                        <Border BorderBrush="#FFFFFF" BorderThickness="1,0,0,0" Cursor="Hand"
                                                MouseLeftButtonUp="Stats_Click">
                                            <Border BorderBrush="#D0CEBF" BorderThickness="0,0,1,0">
                                                <TextBlock Text="{Binding RankText}" VerticalAlignment="Center" Margin="4,0"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Foreground" Value="#000000"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ModalOpen}" Value="True">
                                                                    <Setter Property="Foreground" Value="#ACA899"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Border>
                                        <Border Grid.Column="1" BorderBrush="#FFFFFF" BorderThickness="1,0,0,0" MinWidth="180"
                                                Cursor="Hand" MouseLeftButtonUp="Stats_Click">
                                            <Border BorderBrush="#D0CEBF" BorderThickness="0,0,1,0">
                                                <TextBlock Text="{Binding StreakText}" VerticalAlignment="Center"
                                                           HorizontalAlignment="Right" TextAlignment="Right" Margin="6,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Foreground" Value="#000000"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ModalOpen}" Value="True">
                                                                    <Setter Property="Foreground" Value="#ACA899"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Border>
                                        <Grid Grid.Column="2" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="2">
                                            <Path Stroke="#FFFFFF" StrokeThickness="1" Data="M11,0 L0,11 M11,4 L4,11 M11,8 L8,11"/>
                                            <Path Stroke="#ACA899" StrokeThickness="1" Data="M12,0 L0,12 M12,4 L4,12 M12,8 L8,12"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Border>

                            <!-- Click parent to flash the dialog; XP does not dim the client -->
                            <Border Grid.Row="0" Grid.RowSpan="2" Background="Transparent"
                                    Visibility="{Binding ModalOpen, Converter={StaticResource BoolVis}}"
                                    MouseLeftButtonDown="Scrim_MouseLeftButtonDown"/>

                            <!-- Toast = XP tooltip -->
                            <Border Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12"
                                    Background="#FFFFE1" BorderBrush="#000000" BorderThickness="1" Padding="6,4"
                                    Visibility="{Binding ToastVisible, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding Toast}" FontSize="11"/>
                            </Border>
                                </Grid>
                            </Border>
            </Border>
        </Grid>
    </Border>
</Window>
