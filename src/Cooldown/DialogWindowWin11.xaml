<Window x:Class="Cooldown.DialogWindowWin11"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Cooldown"
        Title="{Binding ModalTitle}"
        Width="560"
        MaxHeight="560"
        SizeToContent="Height"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/hourglass.ico"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Win11Light.xaml"/>
                <ResourceDictionary Source="Themes/Win11.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:BoolVis x:Key="BoolVis"/>
            <local:BoolVis x:Key="InvVis" Invert="True"/>
        </ResourceDictionary>
    </Window.Resources>
    <Window.Style>
        <Style TargetType="local:DialogWindowWin11">
            <Setter Property="Background" Value="{DynamicResource Face}"/>
            <Setter Property="Foreground" Value="{DynamicResource WindowText}"/>
        </Style>
    </Window.Style>
    <Border Background="{DynamicResource Face}" Padding="20,12,20,16">
                <Grid>
                    <Grid Visibility="{Binding ModalProgress, Converter={StaticResource BoolVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock VerticalAlignment="Top"
                                       LineStackingStrategy="BlockLineHeight" LineHeight="118"
                                       Visibility="{Binding IsRanked, Converter={StaticResource BoolVis}}">
                                <Run Text="My rank:"/>
                                <Run FontSize="118" FontWeight="Bold" Text="&#x200B;"/>
                            </TextBlock>
                            <TextBlock VerticalAlignment="Top"
                                       Visibility="{Binding IsRanked, Converter={StaticResource InvVis}}">
                                <Run Text="My rank:"/>
                                <Run FontSize="16" FontWeight="Bold" Text="&#x200B;"/>
                            </TextBlock>
                            <TextBlock Text="{Binding RankLetter}"
                                       FontSize="118" FontWeight="SemiBold" Foreground="{DynamicResource HotTrack}"
                                       HorizontalAlignment="Right" VerticalAlignment="Top"
                                       LineStackingStrategy="BlockLineHeight" LineHeight="118"
                                       Visibility="{Binding IsRanked, Converter={StaticResource BoolVis}}"/>
                            <TextBlock Text="Unranked"
                                       FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource HotTrack}"
                                       HorizontalAlignment="Right" VerticalAlignment="Top"
                                       Visibility="{Binding IsRanked, Converter={StaticResource InvVis}}"/>
                        </Grid>
                        <DockPanel Grid.Row="2" Margin="0,0,0,8" LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="{Binding ScoreText}" MinWidth="64" Height="32"
                                    Padding="12,1" Margin="8,0,0,0" FontWeight="SemiBold"
                                    Style="{StaticResource ClassicButton}"
                                    Command="{Binding OpenJourneyCommand}"/>
                            <TextBlock Text="Score:" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DockPanel Grid.Row="3" Margin="0,0,0,8" LastChildFill="True">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentStreakText}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBlock Text="Current streak" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DockPanel Grid.Row="4" LastChildFill="True">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding BestStreakText}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBlock Text="Best streak" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Grid>

                    <DockPanel Visibility="{Binding ModalJourney, Converter={StaticResource BoolVis}}"
                               LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top" Text="Nothing logged yet." Foreground="{DynamicResource GrayText}"
                                   Margin="0,0,0,8"
                                   Visibility="{Binding HasJourney, Converter={StaticResource InvVis}}"/>
                        <Border Visibility="{Binding HasJourney, Converter={StaticResource BoolVis}}"
                                CornerRadius="8" BorderBrush="{DynamicResource ControlStroke}" BorderThickness="1"
                                Background="{DynamicResource WindowBg}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="320"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Journey}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="12,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding RankLetter}"
                                                           FontWeight="SemiBold" Foreground="{DynamicResource HotTrack}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center" Margin="8,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Points}"
                                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="1" Text="{Binding When}"
                                                           Foreground="{DynamicResource GrayText}" FontSize="11"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </DockPanel>

                    <StackPanel Visibility="{Binding ModalPutOn, Converter={StaticResource BoolVis}}">
                        <Border Margin="0,0,0,12" CornerRadius="8" Background="{DynamicResource CoverFallback}"
                                ClipToBounds="True">
                            <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch">
                                <Grid Width="460" Height="215">
                                    <Image Source="{Binding SelectedGame.Cover}" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="Fant"/>
                                </Grid>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="Congrats!" FontSize="16" FontWeight="SemiBold"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding PutOnPrompt}" FontSize="13"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,16"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Do it!" MinWidth="88" Height="32"
                                    Padding="14,1"
                                    Style="{StaticResource AccentButton}" Command="{Binding PutOnCooldownCommand}"/>
                            <Button DockPanel.Dock="Right" Content="On second thought..." MinWidth="88" Height="32"
                                    Padding="14,1" Margin="0,0,8,0"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding WarnSkipPutOnCommand}"/>
                            <TextBlock/>
                        </DockPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding ModalPutOnWarn, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="Wait! You were so close!"
                                   FontSize="14" FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="Give it another thought"
                                   FontSize="13" TextWrapping="Wrap" Margin="0,8,0,16"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="sorry bro" MinWidth="88" Height="32"
                                    Padding="14,1" Margin="0,0,8,0"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding CloseModalCommand}"/>
                            <Button Content="alr, you got me" MinWidth="88" Height="32"
                                    Padding="14,1"
                                    Style="{StaticResource AccentButton}"
                                    Command="{Binding CancelPutOnWarnCommand}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding ModalTakeOff, Converter={StaticResource BoolVis}}">
                        <Border Margin="0,0,0,12" CornerRadius="8" Background="{DynamicResource CoverFallback}"
                                ClipToBounds="True">
                            <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch">
                                <Grid Width="460" Height="215">
                                    <Image Source="{Binding SelectedGame.Cover}" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="Fant"/>
                                </Grid>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="{Binding TakeOffPrompt}" FontSize="14" FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="... wait, what are you doing?" FontSize="13"
                                   TextWrapping="Wrap" Margin="0,8,0,16"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Perfect" MinWidth="88" Height="32"
                                    Padding="14,1"
                                    Style="{StaticResource AccentButton}"
                                    Command="{Binding CloseModalCommand}"/>
                            <Button DockPanel.Dock="Right" Content="About that..." MinWidth="88" Height="32"
                                    Padding="14,1" Margin="0,0,8,0"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding WarnTakeOffCommand}"/>
                            <TextBlock/>
                        </DockPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding ModalTakeOffWarn, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="Don't do it! You're better than that!"
                                   FontSize="14" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="take it off cooldown" MinWidth="88" Height="32"
                                    Padding="14,1" Margin="0,0,8,0"
                                    Style="{StaticResource DangerButton}"
                                    Command="{Binding TakeOffCooldownCommand}"/>
                            <Button Content="Just kidding!" MinWidth="88" Height="32"
                                    Padding="14,1"
                                    Style="{StaticResource AccentButton}"
                                    Command="{Binding CancelTakeOffWarnCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
    </Border>
</Window>
