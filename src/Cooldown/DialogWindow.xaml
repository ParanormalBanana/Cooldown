<Window x:Class="Cooldown.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Cooldown"
        Title="{Binding ModalTitle}"
        Width="560"
        MaxHeight="560"
        SizeToContent="Height"
        Background="#C0C0C0"
        FontFamily="Tahoma"
        FontSize="11"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/hourglass.ico"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <local:BoolVis x:Key="BoolVis"/>
        <local:BoolVis x:Key="InvVis" Invert="True"/>
    </Window.Resources>
    <Border Background="#C0C0C0">
        <Border BorderBrush="#000000" BorderThickness="0,0,1,1">
            <Border BorderBrush="#FFFFFF" BorderThickness="1,1,0,0">
                <Border BorderBrush="#808080" BorderThickness="0,0,1,1">
                    <Border BorderBrush="#DFDFDF" BorderThickness="1,1,0,0">
                        <DockPanel>
                            <Grid x:Name="ModalCaption" DockPanel.Dock="Top" Height="22"
                                  Background="{StaticResource ActiveCaptionFill}"
                                  MouseLeftButtonDown="Caption_MouseLeftButtonDown">
                                <TextBlock Text="{Binding ModalTitle}" Foreground="White" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="6,0,28,0"
                                           TextTrimming="CharacterEllipsis"
                                           IsHitTestVisible="False"/>
                                <Button Style="{StaticResource CloseButton}" Margin="0,2,3,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding CloseModalCommand}">
                                    <Path Stroke="#000000" StrokeThickness="1.6" Width="8" Height="8" Stretch="Uniform"
                                          Data="M0,0 L8,8 M8,0 L0,8"/>
                                </Button>
                            </Grid>

                            <Grid Margin="12,10,12,12">
                                <StackPanel Visibility="{Binding ModalProgress, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="{Binding PointsText}" FontSize="12" FontWeight="Bold" Foreground="#000080"/>
                                    <TextBlock Text="{Binding LifetimeText}" Margin="0,2,0,10"/>
                                    <TextBlock Text="Stay uninstalled and this page fills up with congratulations."
                                               TextWrapping="Wrap" Margin="0,0,0,8"
                                               Visibility="{Binding HasRewards, Converter={StaticResource InvVis}}"/>
                                    <Border MaxHeight="300" BorderBrush="#808080" BorderThickness="1,1,0,0"
                                            Visibility="{Binding HasRewards, Converter={StaticResource BoolVis}}">
                                        <Border BorderBrush="#000000" BorderThickness="1,1,0,0">
                                            <Border BorderBrush="#FFFFFF" BorderThickness="0,0,1,1" Background="#FFFFFF">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="296">
                                                    <ItemsControl ItemsSource="{Binding RewardsFeed}" Margin="6">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Margin="0,3" Background="#C0C0C0">
                                                                    <Border BorderBrush="#808080" BorderThickness="1,1,0,0">
                                                                        <Border BorderBrush="#FFFFFF" BorderThickness="0,0,1,1" Padding="8,6">
                                                                            <StackPanel>
                                                                                <TextBlock TextWrapping="Wrap">
                                                                                    <Run Text="{Binding Points, Mode=OneWay}" Foreground="#000080" FontWeight="Bold"/>
                                                                                    <Run Text="{Binding Message, Mode=OneWay}" Foreground="#000000"/>
                                                                                </TextBlock>
                                                                                <TextBlock Text="{Binding When}" Foreground="#808080" Margin="0,3,0,0"/>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </Border>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Border>
                                        </Border>
                                    </Border>
                                </StackPanel>

                                <StackPanel Visibility="{Binding ModalPutOn, Converter={StaticResource BoolVis}}">
                                    <Border Margin="0,0,0,10" BorderBrush="#808080" BorderThickness="1,1,0,0">
                                        <Border BorderBrush="#000000" BorderThickness="1,1,0,0">
                                            <Border BorderBrush="#FFFFFF" BorderThickness="0,0,1,1">
                                                <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch">
                                                    <Grid Width="460" Height="215" Background="#008080">
                                                        <Image Source="{Binding SelectedGame.Cover}" Stretch="Uniform"
                                                               RenderOptions.BitmapScalingMode="Fant"/>
                                                    </Grid>
                                                </Viewbox>
                                            </Border>
                                        </Border>
                                    </Border>
                                    <TextBlock Text="Congrats!" FontSize="14" FontWeight="Bold"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding PutOnPrompt}" FontSize="12" FontWeight="Bold"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="It uninstalls the next time Windows starts, or after 5:00 AM if you leave this PC on."
                                               TextWrapping="Wrap" Margin="0,6,0,14"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Do it!" MinWidth="75" Height="23"
                                                Padding="12,1"
                                                Style="{StaticResource AccentButton}" Command="{Binding PutOnCooldownCommand}"/>
                                        <Button DockPanel.Dock="Right" Content="On second thought..." MinWidth="75" Height="23"
                                                Padding="12,1" Margin="0,0,6,0"
                                                Style="{StaticResource GhostButton}"
                                                Command="{Binding CloseModalCommand}"/>
                                        <TextBlock/>
                                    </DockPanel>
                                </StackPanel>

                                <StackPanel Visibility="{Binding ModalAdd, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="Add a game" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock Text="Add one folder as a game, or scan a folder for several."
                                               TextWrapping="Wrap" Margin="0,6,0,14"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Scan a folder" Width="110" Height="23"
                                                Style="{StaticResource AccentButton}" Command="{Binding ScanFolderCommand}"/>
                                        <Button DockPanel.Dock="Right" Content="Add this folder" Width="110" Height="23" Margin="0,0,6,0"
                                                Style="{StaticResource GhostButton}" Command="{Binding AddFolderCommand}"/>
                                        <TextBlock/>
                                    </DockPanel>
                                </StackPanel>

                                <StackPanel Visibility="{Binding ModalTakeOff, Converter={StaticResource BoolVis}}">
                                    <Border Margin="0,0,0,10" BorderBrush="#808080" BorderThickness="1,1,0,0">
                                        <Border BorderBrush="#000000" BorderThickness="1,1,0,0">
                                            <Border BorderBrush="#FFFFFF" BorderThickness="0,0,1,1">
                                                <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch">
                                                    <Grid Width="460" Height="215" Background="#008080">
                                                        <Image Source="{Binding SelectedGame.Cover}" Stretch="Uniform"
                                                               RenderOptions.BitmapScalingMode="Fant"/>
                                                    </Grid>
                                                </Viewbox>
                                            </Border>
                                        </Border>
                                    </Border>
                                    <TextBlock Text="{Binding TakeOffPrompt}" FontSize="12" FontWeight="Bold"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="Take it off if you want it to stay installed."
                                               TextWrapping="Wrap" Margin="0,6,0,14"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Take it off" Width="96" Height="23"
                                                Style="{StaticResource DangerButton}" Command="{Binding TakeOffCooldownCommand}"/>
                                        <Button DockPanel.Dock="Right" Content="Leave it" Width="80" Height="23" Margin="0,0,6,0"
                                                Style="{StaticResource GhostButton}"
                                                Command="{Binding CloseModalCommand}"/>
                                        <TextBlock/>
                                    </DockPanel>
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Border>
            </Border>
        </Border>
    </Border>
</Window>
