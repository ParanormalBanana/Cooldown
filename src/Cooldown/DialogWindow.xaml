<Window x:Class="Cooldown.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Cooldown"
        Title="{Binding ModalTitle}"
        Width="560"
        MaxHeight="560"
        SizeToContent="Height"
        Background="#C0C0C0"
        FontFamily="Tahoma"
        FontSize="11"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/hourglass.ico"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">
    <Window.Resources>
        <local:BoolVis x:Key="BoolVis"/>
        <local:BoolVis x:Key="InvVis" Invert="True"/>
    </Window.Resources>
    <Border Background="#C0C0C0">
        <Border BorderBrush="#000000" BorderThickness="0,0,1,1">
            <Border BorderBrush="#FFFFFF" BorderThickness="1,1,0,0">
                <Border BorderBrush="#808080" BorderThickness="0,0,1,1">
                    <Border BorderBrush="#DFDFDF" BorderThickness="1,1,0,0">
                        <DockPanel>
                            <Grid x:Name="ModalCaption" DockPanel.Dock="Top" Height="22"
                                  Background="{StaticResource ActiveCaptionFill}"
                                  MouseLeftButtonDown="Caption_MouseLeftButtonDown">
                                <TextBlock Text="{Binding ModalTitle}" Foreground="White" FontWeight="Bold"
                                           VerticalAlignment="Center" Margin="6,0,28,0"
                                           TextTrimming="CharacterEllipsis"
                                           IsHitTestVisible="False"/>
                                <Button Style="{StaticResource CloseButton}" Margin="0,2,3,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding CloseModalCommand}">
                                    <Path Stroke="#000000" StrokeThickness="1.6" Width="8" Height="8" Stretch="Uniform"
                                          Data="M0,0 L8,8 M8,0 L0,8"/>
                                </Button>
                            </Grid>

                            <Grid Margin="12,10,12,12">
                                <Grid Visibility="{Binding ModalProgress, Converter={StaticResource BoolVis}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock VerticalAlignment="Top"
                                                   LineStackingStrategy="BlockLineHeight" LineHeight="144"
                                                   Visibility="{Binding IsRanked, Converter={StaticResource BoolVis}}">
                                            <Run Text="My rank:"/>
                                            <Run FontSize="144" FontWeight="Bold" Text="&#x200B;"/>
                                        </TextBlock>
                                        <TextBlock VerticalAlignment="Top"
                                                   Visibility="{Binding IsRanked, Converter={StaticResource InvVis}}">
                                            <Run Text="My rank:"/>
                                            <Run FontSize="16" FontWeight="Bold" Text="&#x200B;"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding RankLetter}"
                                                   FontSize="144" FontWeight="Bold" Foreground="#000080"
                                                   HorizontalAlignment="Right" VerticalAlignment="Top"
                                                   LineStackingStrategy="BlockLineHeight" LineHeight="144"
                                                   Visibility="{Binding IsRanked, Converter={StaticResource BoolVis}}"/>
                                        <TextBlock Text="Unranked"
                                                   FontSize="16" FontWeight="Bold" Foreground="#000080"
                                                   HorizontalAlignment="Right" VerticalAlignment="Top"
                                                   Visibility="{Binding IsRanked, Converter={StaticResource InvVis}}"/>
                                    </Grid>
                                    <DockPanel Grid.Row="2" Margin="0,0,0,8" LastChildFill="True">
                                        <Button DockPanel.Dock="Right" Content="{Binding ScoreText}" MinWidth="51" Height="23"
                                                Padding="8,1" Margin="8,0,0,0" FontWeight="Bold"
                                                Style="{StaticResource ClassicButton}"
                                                Command="{Binding OpenJourneyCommand}"/>
                                        <TextBlock Text="Score:" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <DockPanel Grid.Row="3" Margin="0,0,0,8" LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentStreakText}"
                                                   FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <TextBlock Text="Current streak" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <DockPanel Grid.Row="4" LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding BestStreakText}"
                                                   FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <TextBlock Text="Best streak" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Grid>

                                <DockPanel Visibility="{Binding ModalJourney, Converter={StaticResource BoolVis}}"
                                           LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Top" Text="Nothing logged yet." Foreground="#808080"
                                               Margin="0,0,0,8"
                                               Visibility="{Binding HasJourney, Converter={StaticResource InvVis}}"/>
                                    <Border Visibility="{Binding HasJourney, Converter={StaticResource BoolVis}}"
                                            BorderBrush="#808080" BorderThickness="1,1,0,0">
                                        <Border BorderBrush="#FFFFFF" BorderThickness="0,0,1,1">
                                            <Border BorderBrush="#000000" BorderThickness="1,1,0,0">
                                                <Border BorderBrush="#DFDFDF" BorderThickness="0,0,1,1" Background="#FFFFFF">
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="320"
                                                                  HorizontalScrollBarVisibility="Disabled">
                                                        <ItemsControl ItemsSource="{Binding Journey}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="6,4">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto"/>
                                                                            <RowDefinition Height="Auto"/>
                                                                        </Grid.RowDefinitions>
                                                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                                                                   VerticalAlignment="Center"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding RankLetter}"
                                                                                   FontWeight="Bold" Foreground="#000080"
                                                                                   VerticalAlignment="Center"
                                                                                   HorizontalAlignment="Center" Margin="8,0"/>
                                                                        <TextBlock Grid.Column="2" Text="{Binding Points}"
                                                                                   FontWeight="Bold" VerticalAlignment="Center"/>
                                                                        <TextBlock Grid.Row="1" Text="{Binding When}"
                                                                                   Foreground="#808080" FontSize="10"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </Border>
                                            </Border>
                                        </Border>
                                    </Border>
                                </DockPanel>

                                <StackPanel Visibility="{Binding ModalPutOn, Converter={StaticResource BoolVis}}">
                                    <Border Margin="0,0,0,10" BorderBrush="#808080" BorderThickness="1,1,0,0">
                                        <Border BorderBrush="#000000" BorderThickness="1,1,0,0">
                                            <Border BorderBrush="#FFFFFF" BorderThickness="0,0,1,1">
                                                <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch">
                                                    <Grid Width="460" Height="215" Background="#008080">
                                                        <Image Source="{Binding SelectedGame.Cover}" Stretch="Uniform"
                                                               RenderOptions.BitmapScalingMode="Fant"/>
                                                    </Grid>
                                                </Viewbox>
                                            </Border>
                                        </Border>
                                    </Border>
                                    <TextBlock Text="Congrats!" FontSize="14" FontWeight="Bold"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding PutOnPrompt}" FontSize="12"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,14"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Do it!" MinWidth="75" Height="23"
                                                Padding="12,1"
                                                Style="{StaticResource AccentButton}" Command="{Binding PutOnCooldownCommand}"/>
                                        <Button DockPanel.Dock="Right" Content="On second thought..." MinWidth="75" Height="23"
                                                Padding="12,1" Margin="0,0,6,0"
                                                Style="{StaticResource GhostButton}"
                                                Command="{Binding WarnSkipPutOnCommand}"/>
                                        <TextBlock/>
                                    </DockPanel>
                                </StackPanel>

                                <StackPanel Visibility="{Binding ModalPutOnWarn, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="Wait! You were so close!"
                                               FontSize="12" FontWeight="Bold"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="Give it another thought☺"
                                               FontSize="12"
                                               TextWrapping="Wrap" Margin="0,6,0,14"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="sorry bro" MinWidth="75" Height="23"
                                                Padding="12,1" Margin="0,0,6,0"
                                                Style="{StaticResource GhostButton}"
                                                Command="{Binding CloseModalCommand}"/>
                                        <Button Content="alr, you got me" MinWidth="75" Height="23"
                                                Padding="12,1"
                                                Style="{StaticResource AccentButton}"
                                                Command="{Binding CancelPutOnWarnCommand}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Visibility="{Binding ModalTakeOff, Converter={StaticResource BoolVis}}">
                                    <Border Margin="0,0,0,10" BorderBrush="#808080" BorderThickness="1,1,0,0">
                                        <Border BorderBrush="#000000" BorderThickness="1,1,0,0">
                                            <Border BorderBrush="#FFFFFF" BorderThickness="0,0,1,1">
                                                <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch">
                                                    <Grid Width="460" Height="215" Background="#008080">
                                                        <Image Source="{Binding SelectedGame.Cover}" Stretch="Uniform"
                                                               RenderOptions.BitmapScalingMode="Fant"/>
                                                    </Grid>
                                                </Viewbox>
                                            </Border>
                                        </Border>
                                    </Border>
                                    <TextBlock Text="{Binding TakeOffPrompt}" FontSize="12" FontWeight="Bold"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="... wait, what are you doing?" FontSize="12"
                                               TextWrapping="Wrap" Margin="0,6,0,14"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Perfect" MinWidth="75" Height="23"
                                                Padding="12,1"
                                                Style="{StaticResource AccentButton}"
                                                Command="{Binding CloseModalCommand}"/>
                                        <Button DockPanel.Dock="Right" Content="About that..." MinWidth="75" Height="23"
                                                Padding="12,1" Margin="0,0,6,0"
                                                Style="{StaticResource GhostButton}"
                                                Command="{Binding WarnTakeOffCommand}"/>
                                        <TextBlock/>
                                    </DockPanel>
                                </StackPanel>

                                <StackPanel Visibility="{Binding ModalTakeOffWarn, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="Don't do it! You're better than that!"
                                               FontSize="12" FontWeight="Bold"
                                               TextWrapping="Wrap" Margin="0,0,0,14"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="take it off cooldown" MinWidth="75" Height="23"
                                                Padding="12,1" Margin="0,0,6,0"
                                                Style="{StaticResource DangerButton}"
                                                Command="{Binding TakeOffCooldownCommand}"/>
                                        <Button Content="Just kidding!" MinWidth="75" Height="23"
                                                Padding="12,1"
                                                Style="{StaticResource AccentButton}"
                                                Command="{Binding CancelTakeOffWarnCommand}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Border>
            </Border>
        </Border>
    </Border>
</Window>
