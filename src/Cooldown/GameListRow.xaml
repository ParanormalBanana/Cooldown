<UserControl x:Class="Cooldown.GameListRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Cooldown"
             Cursor="Hand"
             FontFamily="Tahoma"
             UseLayoutRounding="True"
             HorizontalAlignment="Stretch">
    <UserControl.Resources>
        <local:BoolVis x:Key="BoolVis"/>
        <local:BoolVis x:Key="InvVis" Invert="True"/>
    </UserControl.Resources>
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                    <Setter Property="Opacity" Value="0.72"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <UserControl.ContextMenu>
        <ContextMenu Opened="CardMenu_Opened"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <ContextMenu.Resources>
                <local:BoolVis x:Key="BoolVis"/>
                <local:BoolVis x:Key="InvVis" Invert="True"/>
            </ContextMenu.Resources>
            <MenuItem Header="Hide game" Click="Hide_Click"
                      Visibility="{Binding IsHidden, Converter={StaticResource InvVis}}"/>
            <MenuItem Header="Unhide game" Click="Unhide_Click"
                      Visibility="{Binding IsHidden, Converter={StaticResource BoolVis}}"/>
            <MenuItem Header="Not a game" Click="NotAGame_Click"/>
            <Separator/>
            <MenuItem x:Name="ToggleHiddenItem" Header="Show hidden games" IsCheckable="True"
                      Click="ToggleHidden_Click"/>
            <MenuItem x:Name="ToggleCooldownsOnTopItem" Header="Cooldown games on top" IsCheckable="True"
                      Click="ToggleCooldownsOnTop_Click"/>
            <Separator/>
            <MenuItem x:Name="GridViewItem" Header="Grid" IsCheckable="True"
                      Click="ShowGrid_Click"/>
            <MenuItem x:Name="ListViewItem" Header="List" IsCheckable="True"
                      Click="ShowDetails_Click"/>
            <Separator/>
            <MenuItem Header="Settings..." Click="Settings_Click"/>
        </ContextMenu>
    </UserControl.ContextMenu>
    <Border x:Name="Root" SnapsToDevicePixels="True" UseLayoutRounding="True"
            HorizontalAlignment="Stretch"
            Background="#C0C0C0"
            BorderBrush="#000000"
            BorderThickness="0,0,1,1"
            MouseLeftButtonDown="Row_MouseLeftButtonDown"
            MouseLeftButtonUp="Row_MouseLeftButtonUp"
            LostMouseCapture="Row_LostMouseCapture"
            MouseEnter="Row_MouseEnter"
            MouseLeave="Row_MouseLeave">
        <Border x:Name="BevelWhite" BorderBrush="#FFFFFF" BorderThickness="1,1,0,0">
            <Border x:Name="BevelDark" BorderBrush="#808080" BorderThickness="0,0,1,1">
                <Border x:Name="BevelLight" BorderBrush="#DFDFDF" BorderThickness="1,1,0,0">
                    <Border x:Name="PressShift">
        <Grid Height="22" Margin="4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="148"/>
                <ColumnDefinition Width="88"/>
                <ColumnDefinition Width="148"/>
            </Grid.ColumnDefinitions>
            <Border Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#C0C0C0"
                    Visibility="{Binding OnCooldown, Converter={StaticResource BoolVis}}">
                <Border BorderBrush="#000000" BorderThickness="0,0,1,1">
                    <Border BorderBrush="#FFFFFF" BorderThickness="1,1,0,0">
                        <Border BorderBrush="#808080" BorderThickness="0,0,1,1">
                            <Grid Margin="1" SnapsToDevicePixels="True">
                                <Image Source="pack://application:,,,/Assets/hourglass-16-white.png"
                                       Stretch="Uniform" Margin="1,1,0,0" Opacity="0.4"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                <Rectangle Fill="#3A3A3A" Margin="0,0,1,1"
                                           SnapsToDevicePixels="True">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="pack://application:,,,/Assets/hourglass-16.png"
                                                    Stretch="Uniform"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </Grid>
                        </Border>
                    </Border>
                </Border>
            </Border>
            <Grid Grid.Column="1" Margin="2,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" Background="#008080"
                        BorderBrush="#808080" BorderThickness="1">
                    <Image Source="{Binding Cover}" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="11" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
            <TextBlock Grid.Column="2" Text="{Binding Launcher}" FontSize="11"
                       HorizontalAlignment="Stretch" TextAlignment="Right"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0"/>
            <TextBlock Grid.Column="3" Text="{Binding DaysText}" FontSize="11"
                       HorizontalAlignment="Stretch" TextAlignment="Right"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0"/>
            <TextBlock Grid.Column="4" Text="{Binding ReinstallsText}" FontSize="11"
                       HorizontalAlignment="Stretch" TextAlignment="Right"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0"/>
            <TextBlock Grid.Column="5" Text="{Binding ScoreText}" FontSize="11"
                       HorizontalAlignment="Stretch" TextAlignment="Right"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0"/>
        </Grid>
                    </Border>
                </Border>
            </Border>
        </Border>
    </Border>
</UserControl>
