<Window x:Class="Cooldown.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Cooldown"
        Title="Cooldown"
        Width="1180" Height="780" MinWidth="960" MinHeight="640"
        Background="#C0C0C0"
        Foreground="#000000"
        FontFamily="Tahoma"
        FontSize="11"
        WindowStyle="None"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/hourglass.ico"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown"
        SizeChanged="Window_SizeChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="4"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <local:BoolVis x:Key="BoolVis"/>
        <local:BoolVis x:Key="InvVis" Invert="True"/>
    </Window.Resources>

    <Border x:Name="Root" Background="#C0C0C0">
        <Border BorderThickness="0,0,1,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="#000000"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ModalOpen}" Value="True">
                            <Setter Property="BorderBrush" Value="#5A5A5A"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border BorderThickness="1,1,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#FFFFFF"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ModalOpen}" Value="True">
                                <Setter Property="BorderBrush" Value="#E4E4E4"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border BorderThickness="0,0,1,1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="#808080"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ModalOpen}" Value="True">
                                    <Setter Property="BorderBrush" Value="#9A9A9A"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border BorderThickness="1,1,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="#DFDFDF"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ModalOpen}" Value="True">
                                        <Setter Property="BorderBrush" Value="#D0D0D0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="22"/>
                            </Grid.RowDefinitions>

                            <!-- Caption -->
                            <Grid Grid.Row="0" Margin="0,0,2,0">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Background" Value="{StaticResource ActiveCaptionFill}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ModalOpen}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource InactiveCaptionFill}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid Margin="12,0,6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Width="16" Height="16" Margin="0,0,6,0"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"
                                           SnapsToDevicePixels="True"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           Source="pack://application:,,,/Assets/hourglass-16-white.png">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ModalOpen}" Value="True">
                                                        <Setter Property="Opacity" Value="0.72"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <TextBlock Grid.Column="1" Text="Cooldown" FontWeight="Bold"
                                               FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ModalOpen}" Value="True">
                                                        <Setter Property="Foreground" Value="#D4D4D4"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ModalOpen}" Value="True">
                                                        <Setter Property="Opacity" Value="0.6"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Minimize" Margin="0,0,2,0">
                                            <Path Fill="#000000" Data="M2,11 H14 V13 H2 Z" Width="12" Height="12" Stretch="Uniform"/>
                                        </Button>
                                        <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="Maximize" Margin="0,0,2,0">
                                            <Grid Width="10" Height="10">
                                                <Path x:Name="MaxIcon" Stroke="#000000" StrokeThickness="1.4" Fill="Transparent"
                                                      Data="M0,2 H10 V10 H0 Z M0,2 H10 V4 H0 Z"/>
                                                <Canvas x:Name="RestoreIcon" Visibility="Collapsed" Width="10" Height="10">
                                                    <Path Stroke="#000000" StrokeThickness="1.2" Fill="Transparent"
                                                          Data="M2,0 H10 V6"/>
                                                    <Path Stroke="#000000" StrokeThickness="1.2" Fill="Transparent"
                                                          Data="M0,3 H8 V10 H0 Z M0,3 H8 V5 H0 Z"/>
                                                </Canvas>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource CaptionCloseButton}" Click="Close_Click" ToolTip="Close">
                                            <Path Stroke="#000000" StrokeThickness="1.6" Width="8" Height="8" Stretch="Uniform"
                                                  Data="M0,0 L8,8 M8,0 L0,8"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <!-- Library -->
                            <Grid Grid.Row="1">
                                <Grid.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Show hidden games" IsCheckable="True"
                                                  IsChecked="{Binding ShowHidden, Mode=OneWay}"
                                                  Command="{Binding ToggleHiddenCommand}"/>
                                        <MenuItem Header="Cooldown games on top" IsCheckable="True"
                                                  IsChecked="{Binding CooldownsOnTop, Mode=OneWay}"
                                                  Command="{Binding ToggleCooldownsOnTopCommand}"/>
                                        <Separator/>
                                        <MenuItem Header="Settings..." Command="{Binding OpenSettingsCommand}"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Margin="8,6,8,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                                             Height="23" VerticalContentAlignment="Center"
                                             IsEnabled="{Binding ParentEnabled}"/>
                                    <Button Grid.Column="1" Content="+" Width="26" Height="23" Margin="6,0,0,0" Padding="0"
                                            FontSize="12" FontWeight="Bold"
                                            Style="{StaticResource GhostButton}"
                                            Command="{Binding OpenAddCommand}"
                                            IsEnabled="{Binding ParentEnabled}"
                                            ToolTip="Add a game or scan a folder"/>
                                    <Button Grid.Column="2" Content="{Binding RescanLabel}" MinWidth="100" Height="23" Margin="6,0,0,0"
                                            Padding="10,2"
                                            Style="{StaticResource AccentButton}"
                                            Command="{Binding RescanCommand}"
                                            IsEnabled="{Binding RescanEnabled}"/>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,0,8,6" Background="#C0C0C0">
                                    <ListBox x:Name="GameList"
                                             ItemsSource="{Binding Rows}"
                                             Background="#C0C0C0"
                                             BorderThickness="0"
                                             Padding="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.CanContentScroll="True"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling"
                                             VirtualizingPanel.ScrollUnit="Pixel">
                                        <ListBox.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="Show hidden games" IsCheckable="True"
                                                  IsChecked="{Binding ShowHidden, Mode=OneWay}"
                                                  Command="{Binding ToggleHiddenCommand}"/>
                                                <MenuItem Header="Cooldown games on top" IsCheckable="True"
                                                  IsChecked="{Binding CooldownsOnTop, Mode=OneWay}"
                                                  Command="{Binding ToggleCooldownsOnTopCommand}"/>
                                                <Separator/>
                                                <MenuItem Header="Settings..." Command="{Binding OpenSettingsCommand}"/>
                                            </ContextMenu>
                                        </ListBox.ContextMenu>
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel Margin="0,-4"/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Focusable" Value="False"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <ContentPresenter/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="4,0">
                                                    <TextBlock Text="{Binding Header}" FontSize="11" FontWeight="Bold"
                                                               Margin="8,6,8,2"
                                                               Visibility="{Binding IsHeader, Converter={StaticResource BoolVis}}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                <Setter Property="Foreground" Value="#000080"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DataContext.ModalOpen, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                        <Setter Property="Foreground" Value="#808080"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <ItemsControl ItemsSource="{Binding Items}"
                                                                  Visibility="{Binding HasItems, Converter={StaticResource BoolVis}}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <UniformGrid Rows="1"
                                                                             Columns="{Binding DataContext.ColumnCount, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <local:GameCard Margin="4,4"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <TextBlock Text="{Binding EmptyMessage}"
                                               Margin="12,16"
                                               Visibility="{Binding ShowEmpty, Converter={StaticResource BoolVis}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Foreground" Value="#000000"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ModalOpen}" Value="True">
                                                        <Setter Property="Foreground" Value="#808080"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Visibility="{Binding ShowSplash, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="Finding your games..." FontSize="12" FontWeight="Bold"
                                                   HorizontalAlignment="Center" Margin="0,0,0,8">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Foreground" Value="#000000"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ModalOpen}" Value="True">
                                                            <Setter Property="Foreground" Value="#808080"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding SplashStatus}" FontSize="11"
                                                   HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Foreground" Value="#000000"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ModalOpen}" Value="True">
                                                            <Setter Property="Foreground" Value="#808080"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ProgressBar IsIndeterminate="True" Width="280" Height="18" Margin="0,14,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <!-- Status bar -->
                            <Border Grid.Row="2" BorderBrush="#FFFFFF" BorderThickness="0,1,0,0">
                                <Border BorderBrush="#808080" BorderThickness="0,1,0,0" Margin="0,1,0,0">
                                    <Grid Margin="2,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="16"/>
                                        </Grid.ColumnDefinitions>
                                        <Border BorderBrush="#808080" BorderThickness="1,1,0,0" Margin="1" Cursor="Hand"
                                                MouseLeftButtonUp="Stats_Click">
                                            <Border BorderBrush="#FFFFFF" BorderThickness="0,0,1,1">
                                                <TextBlock Text="{Binding PointsText}" VerticalAlignment="Center" Margin="6,0"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Foreground" Value="#000000"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ModalOpen}" Value="True">
                                                                    <Setter Property="Foreground" Value="#808080"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Border>
                                        <Border Grid.Column="1" BorderBrush="#808080" BorderThickness="1,1,0,0" Margin="1" MinWidth="180"
                                                Cursor="Hand" MouseLeftButtonUp="Stats_Click">
                                            <Border BorderBrush="#FFFFFF" BorderThickness="0,0,1,1">
                                                <TextBlock Text="{Binding StreakText}" VerticalAlignment="Center" Margin="6,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Foreground" Value="#000000"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ModalOpen}" Value="True">
                                                                    <Setter Property="Foreground" Value="#808080"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Border>
                                        <Grid Grid.Column="2" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="1">
                                            <Path Stroke="#808080" StrokeThickness="1" Data="M14,0 L0,14 M14,4 L4,14 M14,8 L8,14 M14,12 L12,14"/>
                                            <Path Stroke="#FFFFFF" StrokeThickness="1" Data="M13,0 L0,13 M13,4 L4,13 M13,8 L8,13"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Border>

                            <!-- Inactive parent wash: flatten chrome without a colored scrim -->
                            <Border Grid.Row="1" Grid.RowSpan="2" Background="#4DC0C0C0" IsHitTestVisible="False"
                                    Visibility="{Binding ModalOpen, Converter={StaticResource BoolVis}}"/>

                            <Border Grid.RowSpan="3" Background="Transparent"
                                    Visibility="{Binding ModalOpen, Converter={StaticResource BoolVis}}"
                                    MouseLeftButtonDown="Scrim_MouseLeftButtonDown"/>

                            <!-- Toast = classic tooltip -->
                            <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12"
                                    Background="#FFFFE1" BorderBrush="#000000" BorderThickness="1" Padding="6,4"
                                    Visibility="{Binding ToastVisible, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding Toast}" FontSize="11"/>
                            </Border>
                        </Grid>
                    </Border>
                </Border>
            </Border>
        </Border>
    </Border>
</Window>
