<Window x:Class="Cooldown.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Cooldown"
        Title="Cooldown"
        Width="1180" Height="780" MinWidth="960" MinHeight="640"
        Background="#0D0F12"
        Foreground="#F2F4F7"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <local:BoolVis x:Key="BoolVis"/>
        <local:BoolVis x:Key="InvVis" Invert="True"/>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="#1A1E24"/>
            <Setter Property="Foreground" Value="#F2F4F7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#252B34"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Background" Value="#3D8A8A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5EB7B7"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Background" Value="#D27A7A"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B45F5F"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8B98A8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="18"
                                Width="36" Height="36">
                            <TextBlock Text="×" FontSize="22" FontWeight="Normal"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="0,-2,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#252B34"/>
                                <Setter Property="Foreground" Value="#F2F4F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#171B22"/>
            <Setter Property="Foreground" Value="#F2F4F7"/>
            <Setter Property="BorderBrush" Value="#3F5266"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#F2F4F7"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F2F4F7"/>
            <Setter Property="Margin" Value="0,6"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1A1E24"/>
            <Setter Property="Foreground" Value="#F2F4F7"/>
            <Setter Property="BorderBrush" Value="#2C3848"/>
            <Setter Property="CaretBrush" Value="#5EB7B7"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style x:Key="ThinThumb" TargetType="Thumb">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Pill" CornerRadius="4" Background="#4A5666"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#5EB7B7"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#5EB7B7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostRepeat" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="VerticalThinBar" TargetType="ScrollBar">
            <Grid Background="Transparent" Width="10">
                <Track x:Name="PART_Track" IsDirectionReversed="True" Width="6" HorizontalAlignment="Center">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource GhostRepeat}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ThinThumb}"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource GhostRepeat}"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>
        <ControlTemplate x:Key="HorizontalThinBar" TargetType="ScrollBar">
            <Grid Background="Transparent" Height="10">
                <Track x:Name="PART_Track" Height="6" VerticalAlignment="Center">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource GhostRepeat}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ThinThumb}"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource GhostRepeat}"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="10"/>
                    <Setter Property="MinWidth" Value="10"/>
                    <Setter Property="Template" Value="{StaticResource VerticalThinBar}"/>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="MinHeight" Value="10"/>
                    <Setter Property="Template" Value="{StaticResource HorizontalThinBar}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="22,16,22,8">
            <TextBlock Text="COOLDOWN" FontSize="26" FontWeight="Bold" Foreground="#5EB7B7"
                       VerticalAlignment="Center"/>
            <Border HorizontalAlignment="Right" Background="#171B22" CornerRadius="12" Padding="16,12" Cursor="Hand"
                    MouseLeftButtonUp="Stats_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding PointsText}" FontSize="16" FontWeight="Bold" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding StreakText}" FontSize="13" Foreground="#8B98A8" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Library -->
        <Grid Grid.Row="1" Visibility="{Binding ShowLibrary, Converter={StaticResource BoolVis}}">
            <Grid.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="{Binding ShowHiddenLabel}" Command="{Binding ToggleHiddenCommand}"/>
                </ContextMenu>
            </Grid.ContextMenu>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="22,0,22,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                         Height="36" VerticalContentAlignment="Center"
                         Tag="Search installed games"/>
                <Button Grid.Column="1" Content="+" Width="36" Height="36" Margin="8,0,0,0" Padding="0"
                        FontSize="20" FontWeight="SemiBold"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding OpenAddCommand}"
                        ToolTip="Add a game or scan a folder"/>
                <Button Grid.Column="2" Content="{Binding RescanLabel}" Width="90" Height="36" Margin="8,0,0,0"
                        Style="{StaticResource AccentButton}"
                        Command="{Binding RescanCommand}"
                        IsEnabled="{Binding RescanEnabled}"/>
            </Grid>

            <Grid Grid.Row="1" Margin="12,0,12,12">
                <ListBox x:Name="GameList"
                         ItemsSource="{Binding Rows}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="{Binding ShowHiddenLabel}" Command="{Binding ToggleHiddenCommand}"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Header}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="#8B98A8" Margin="10,16,10,4"
                                           Visibility="{Binding IsHeader, Converter={StaticResource BoolVis}}"/>
                                <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,0,0"
                                              Visibility="{Binding HasItems, Converter={StaticResource BoolVis}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"
                                                         Columns="{Binding DataContext.ColumnCount, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <local:GameCard Margin="6"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="{Binding EmptyMessage}"
                           Foreground="#8B98A8" Margin="16,24"
                           Visibility="{Binding ShowEmpty, Converter={StaticResource BoolVis}}"/>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding ShowSplash, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="Finding your games" FontSize="24" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding SplashStatus}" Foreground="#8B98A8" FontSize="14"
                               HorizontalAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True" Width="280" Height="4" Margin="0,22,0,0"
                                 Foreground="#5EB7B7" Background="#1A1E24" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Progress -->
        <DockPanel Grid.Row="1" Margin="22,0,22,16"
                   Visibility="{Binding ShowProgress, Converter={StaticResource BoolVis}}">
            <Button DockPanel.Dock="Top" Content="←  Library" Width="110" Height="34"
                    HorizontalAlignment="Left" Style="{StaticResource GhostButton}"
                    Command="{Binding OpenLibraryCommand}" Margin="0,0,0,8"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="18,0">
                <StackPanel>
                    <TextBlock Text="{Binding PointsText}" FontSize="24" FontWeight="Bold" Foreground="#5EB7B7" Margin="8,8,8,0"/>
                    <TextBlock Text="{Binding LifetimeText}" Foreground="#8B98A8" Margin="8,0,8,12"/>
                    <TextBlock Text="Stay uninstalled and this page fills up with congratulations."
                               Foreground="#8B98A8" Margin="8"
                               Visibility="{Binding HasRewards, Converter={StaticResource InvVis}}"/>
                    <ItemsControl ItemsSource="{Binding RewardsFeed}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#171B22" CornerRadius="10" Margin="0,4" Padding="12,10">
                                    <StackPanel>
                                        <TextBlock TextWrapping="Wrap">
                                            <Run Text="{Binding Points, Mode=OneWay}" Foreground="#5EB7B7"/>
                                            <Run Text="{Binding Message, Mode=OneWay}" Foreground="#F2F4F7"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding When}" Foreground="#8B98A8" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- Modal overlay -->
        <Grid Grid.RowSpan="2" Visibility="{Binding ModalOpen, Converter={StaticResource BoolVis}}">
            <Border Background="#9905080C" MouseLeftButtonDown="Scrim_MouseLeftButtonDown"/>
            <Border Width="480" MaxWidth="480"
                    Background="#171B22" CornerRadius="18"
                    BorderBrush="#3F5266" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="28,16,28,28"
                    MouseLeftButtonDown="ModalCard_MouseLeftButtonDown">
                <DockPanel>
                    <Button DockPanel.Dock="Top"
                            Style="{StaticResource CloseButton}"
                            HorizontalAlignment="Right"
                            Command="{Binding CloseModalCommand}"/>

                    <Grid VerticalAlignment="Center">
                        <StackPanel Visibility="{Binding ModalPutOn, Converter={StaticResource BoolVis}}">
                            <Border Height="140" CornerRadius="12" ClipToBounds="True" Margin="0,0,0,16">
                                <Grid>
                                    <Border Background="#161D26"/>
                                    <Image Source="{Binding ModalCover}" Stretch="UniformToFill"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding PutOnPrompt}" FontSize="20" FontWeight="Bold"
                                       TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
                            <TextBlock Text="It uninstalls the next time Windows starts, or after 5:00 AM if you leave this PC on."
                                       Foreground="#8B98A8" TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" Margin="0,8,0,22" MaxWidth="400"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Do it!" Width="140" Height="44"
                                        Style="{StaticResource AccentButton}" Command="{Binding PutOnCooldownCommand}"/>
                                <Button DockPanel.Dock="Right" Content="On second thought..." Width="180" Height="44" Margin="0,0,8,0"
                                        Style="{StaticResource GhostButton}" Foreground="#8B98A8"
                                        Command="{Binding CloseModalCommand}"/>
                                <TextBlock/>
                            </DockPanel>
                        </StackPanel>

                        <StackPanel Visibility="{Binding ModalAdd, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="Add a game" FontSize="20" FontWeight="Bold"
                                       TextAlignment="Center" HorizontalAlignment="Center"/>
                            <TextBlock Text="Add one folder as a game, or scan a folder for several."
                                       Foreground="#8B98A8" TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" Margin="0,8,0,22" MaxWidth="400"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Scan a folder" Width="140" Height="44"
                                        Style="{StaticResource AccentButton}" Command="{Binding ScanFolderCommand}"/>
                                <Button DockPanel.Dock="Right" Content="Add this folder" Width="150" Height="44" Margin="0,0,8,0"
                                        Style="{StaticResource GhostButton}" Command="{Binding AddFolderCommand}"/>
                                <TextBlock/>
                            </DockPanel>
                        </StackPanel>

                        <StackPanel Visibility="{Binding ModalTakeOff, Converter={StaticResource BoolVis}}">
                            <Border Height="140" CornerRadius="12" ClipToBounds="True" Margin="0,0,0,16">
                                <Grid>
                                    <Border Background="#161D26"/>
                                    <Image Source="{Binding ModalCover}" Stretch="UniformToFill"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding TakeOffPrompt}" FontSize="20" FontWeight="Bold"
                                       TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
                            <TextBlock Text="Take it off if you want it to stay installed."
                                       Foreground="#8B98A8" TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" Margin="0,8,0,22"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Take it off" Width="140" Height="44"
                                        Style="{StaticResource DangerButton}" Command="{Binding TakeOffCooldownCommand}"/>
                                <Button DockPanel.Dock="Right" Content="Leave it" Width="120" Height="44" Margin="0,0,8,0"
                                        Style="{StaticResource GhostButton}" Foreground="#8B98A8"
                                        Command="{Binding CloseModalCommand}"/>
                                <TextBlock/>
                            </DockPanel>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Toast -->
        <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,28"
                Background="#1A1E24" CornerRadius="8" Padding="18,10"
                Visibility="{Binding ToastVisible, Converter={StaticResource BoolVis}}">
            <TextBlock Text="{Binding Toast}"/>
        </Border>
    </Grid>
</Window>
