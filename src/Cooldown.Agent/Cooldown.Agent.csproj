<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Cooldown.Agent</AssemblyName>
    <RootNamespace>Cooldown</RootNamespace>
    <Product>Cooldown</Product>
    <Description>Cooldown background agent</Description>
    <Version>0.10.0</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>embedded</DebugType>
    <ApplicationIcon>..\Cooldown\Assets\hourglass.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Cooldown.Core\Cooldown.Core.csproj" />
  </ItemGroup>
</Project>
